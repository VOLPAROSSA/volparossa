  "local_patches": [
    {
      "target": "xquic",
      "applies_to_commit": "6957ccf9b9fcb9ab62c43672638876abe47162dc",
      "file": "patches/volparossa-xquic.patch",
      "sha256": "acdb5af1a3ba452cfd49b46c80e99e49774db43e1130d032808d4e538772353b",
      "purpose": [
        "invoke the certificate callback on every handshake when requested",
        "bind each created QUIC path to an explicit local and remote tuple",
        "expose ACKed transport bytes under a non-payload label",
        "avoid a null source pointer in the zero-length first-ALPN-list copy",
        "return overflow-checked, XQC_ALIGNMENT-aligned large pool allocations",
        "avoid a null source pointer when no client session ticket is configured",
        "avoid a null data pointer copy for a zero-length stream frame carrying FIN"
      ]
    },
    {
      "target": "xquic",
      "applies_to_commit": "6957ccf9b9fcb9ab62c43672638876abe47162dc",
      "applies_after": "patches/volparossa-xquic.patch",
      "file": "patches/volparossa-xquic-edt.patch",
      "sha256": "1cf0fc84fe87a6057ad654a412b7b9b2edc47d71875e06d6fc17079a6bef6ebf",
      "purpose": [
        "select exactly one writable path by bounded estimated delivery time",
        "use live RTT, in-flight queue, bandwidth, congestion window and recent loss",
        "give each healthy active path continuous service within 256 KiB plus one scheduled packet after a 2 MiB ACKed bootstrap floor",
        "stop forced service after 8 MiB attempted debt plus one scheduled packet without sufficient ACK progress",
        "exclude congestion-blocked paths without reinjection, duplication or FEC",
        "exercise same-session 4 MiB fairness and reject a later congested lossy path in one deterministic native contract test"
      ]
    },
    {
      "target": "mqvpn",
      "applies_to_commit": "607c0df921e2c23bae8bea21cb3c6f2acb2db275",
      "file": "patches/volparossa-mqvpn.patch",
      "sha256": "91885f49781c5fc38f9d1822c2b98ffec135fc939c769b678acccd7de48fa887",
      "purpose": [
        "enforce a caller-supplied leaf SPKI SHA-256 pin",
        "carry explicit per-path local and remote socket tuples into xquic",
        "surface real path congestion, loss, RTT, rate, and ACKed transport counters",
        "attach a stable server session ID to client-originated inner-packet delivery",
        "accept bounded in-memory server TLS identity and synchronously initialize xquic through sealed anonymous Linux memfds",
        "wipe copied authentication, TLS-name, user-slot, client, server, and temporary SPKI material",
        "honour the server multipath configuration without an implicit enable override",
        "bound every app-accepted and pre-H3 server QUIC connection with exact-once teardown accounting",
        "pin server UDP ingress and egress to one canonical caller-supplied remote peer",
        "bind each H3 connection to one lifetime-affine CONNECT-IP claim with idempotent request-close and connection-close session teardown",
        "exercise duplicate-stream bodies and owner-sensitive Datagram IDs, pre-H3 MaxClients refusal and reuse, and unsupported-ALPN cb_refuse capacity reuse through raw QUIC/H3 integration tests without hard-coding VOLPAROSSA's separate MaxClients=1 product policy"
      ]
    },
    {
      "target": "mqvpn",
      "applies_to_commit": "607c0df921e2c23bae8bea21cb3c6f2acb2db275",
      "applies_after": "patches/volparossa-mqvpn.patch",
      "file": "patches/volparossa-mqvpn-exit-paths.patch",
      "sha256": "da22508590dd066852344ac685cb1fc53dfdfaebaed16353ae53f8675f7e1427",
      "purpose": [
        "feed exact per-path local tuples into the xquic server",
        "route xquic server egress through caller-owned path descriptors"
      ]
    },
    {
      "target": "mqvpn",
      "applies_to_commit": "607c0df921e2c23bae8bea21cb3c6f2acb2db275",
      "applies_after": "patches/volparossa-mqvpn-exit-paths.patch",
      "file": "patches/volparossa-mqvpn-edt.patch",
      "sha256": "eeea5b5d09e1225633e0a1fdd1f78c64384cc18bc676088b18bd5f1f41a1f00f",
      "purpose": [
        "expose the VOLPAROSSA EDT scheduler as an explicit mqvpn mode",
        "wire the mode to the exact xquic scheduler callback for client and server settings"
      ]
    }
  ],
