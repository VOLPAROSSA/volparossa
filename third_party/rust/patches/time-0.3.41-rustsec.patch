+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn nested_comment(depth: usize) -> Vec<u8> {
+        let mut input = vec![b'('; depth];
+        input.push(b'x');
+        input.extend(core::iter::repeat_n(b')', depth));
+        input
+    }
+
+    #[test]
+    fn rfc2822_comment_recursion_is_bounded() {
+        let accepted = nested_comment(usize::from(DEPTH_LIMIT - 1));
+        assert!(cfws(&accepted).unwrap().into_inner().is_empty());
+
+        let rejected = nested_comment(usize::from(DEPTH_LIMIT));
+        assert!(cfws(&rejected).is_none());
+    }
