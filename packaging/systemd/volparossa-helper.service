[Unit]
Description=VOLPAROSSA minimal privileged network helper
Documentation=file:/usr/share/doc/volparossa/OPERATIONS.md
Before=volparossa-agent.service
After=local-fs.target
ConditionPathExists=/etc/volparossa/config.yaml

[Service]
Type=simple
ExitType=main
RemainAfterExit=no
User=root
Group=volparossa
UMask=0077
Environment=VOLPAROSSA_CONFIG=/etc/volparossa/config.yaml
Environment=VOLPAROSSA_RUNTIME_DIRECTORY=/run/volparossa
Environment=VOLPAROSSA_HELPER_SOCKET=/run/volparossa/helper.sock
ExecStart=/usr/libexec/volparossa/volparossa-helper
SuccessExitStatus=
Restart=on-failure
RestartMode=normal
RestartSec=3s
RestartForceExitStatus=
RestartPreventExitStatus=70 71
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
TimeoutStopFailureMode=terminate
TimeoutStartSec=30s
TimeoutStopSec=45s
LimitCORE=0
NotifyAccess=main
FileDescriptorStoreMax=128
FileDescriptorStorePreserve=yes

NoNewPrivileges=yes
CapabilityBoundingSet=CAP_KILL CAP_NET_ADMIN CAP_NET_RAW CAP_SETGID CAP_SETPCAP CAP_SETUID CAP_SYS_ADMIN
AmbientCapabilities=CAP_KILL CAP_NET_ADMIN CAP_NET_RAW CAP_SETGID CAP_SETPCAP CAP_SETUID CAP_SYS_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectControlGroups=strict
Delegate=no
PrivatePIDs=no
ProtectKernelModules=yes
ProtectKernelTunables=no
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
# systemd v257 blocks openat2(2) wholesale when this is enabled. The helper requires openat2
# without fallback for race-free pinned process, cgroup, and namespace resolution.
RestrictSUIDSGID=no
RestrictNamespaces=net
PrivateMounts=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io seccomp
SystemCallFilter=~@mount
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/run/volparossa -/run/netns
ReadOnlyPaths=/etc/volparossa

[Install]
WantedBy=multi-user.target
