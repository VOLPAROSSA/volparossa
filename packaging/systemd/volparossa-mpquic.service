[Unit]
Description=VOLPAROSSA isolated native Multipath QUIC transport
Documentation=file:/usr/share/doc/volparossa/OPERATIONS.md
Before=volparossa-agent.service
After=network.target
ConditionPathExists=/usr/libexec/volparossa/volparossa-mpquic
ConditionFileIsExecutable=/usr/libexec/volparossa/volparossa-mpquic-launch

[Service]
Type=simple
User=volparossa
Group=volparossa
UMask=0077
Environment=VOLPAROSSA_MPQUIC_SOCKET=/run/volparossa/native/mpquic.sock
ExecStart=/usr/libexec/volparossa/volparossa-mpquic-launch
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=30s

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateMounts=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/volparossa/native
ReadOnlyPaths=/etc/volparossa

[Install]
WantedBy=multi-user.target
