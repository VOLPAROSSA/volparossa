#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Start separate immutable-role native workers for the roles of this one node.
set -eu

export LC_ALL=C
umask 077

config=${VOLPAROSSA_CONFIG:-/etc/volparossa/config.yaml}
socket=${VOLPAROSSA_MPQUIC_SOCKET:-/run/volparossa/native/mpquic.sock}
binary=/usr/libexec/volparossa/volparossa-mpquic

case "$config" in
    /*) ;;
    *) printf '%s\n' 'VOLPAROSSA_CONFIG must be an absolute path.' >&2; exit 64 ;;
esac
case "$socket" in
    /*) ;;
    *) printf '%s\n' 'VOLPAROSSA_MPQUIC_SOCKET must be an absolute path.' >&2; exit 64 ;;
esac
if [ ! -r "$config" ]; then
    printf 'VOLPAROSSA configuration is not readable: %s\n' "$config" >&2
    exit 66
fi
if [ ! -x "$binary" ]; then
    printf 'Native VOLPAROSSA executable is unavailable: %s\n' "$binary" >&2
    exit 69
fi

mode=$(awk '
    BEGIN {
        in_roles = 0
        client = ""
        exit_role = ""
        invalid = 0
    }
    /^[^[:space:]#][^:]*:[[:space:]]*(#.*)?$/ {
        in_roles = ($0 ~ /^roles:[[:space:]]*(#.*)?$/)
        next
    }
    in_roles && /^[[:space:]]+client:[[:space:]]*/ {
        line = $0
        sub(/[[:space:]]*#.*/, "", line)
        sub(/^[[:space:]]*client:[[:space:]]*/, "", line)
        sub(/[[:space:]]*$/, "", line)
        if (client != "" || (line != "true" && line != "false")) invalid = 1
        client = line
        next
    }
    in_roles && /^[[:space:]]+exit:[[:space:]]*/ {
        line = $0
        sub(/[[:space:]]*#.*/, "", line)
        sub(/^[[:space:]]*exit:[[:space:]]*/, "", line)
        sub(/[[:space:]]*$/, "", line)
        if (exit_role != "" || (line != "true" && line != "false")) invalid = 1
        exit_role = line
        next
    }
    END {
        if (invalid || client == "" || exit_role == "") {
            print "invalid"
        } else if (client == "true" && exit_role == "true") {
            print "combined"
        } else if (client == "true") {
            print "client"
        } else if (exit_role == "true") {
            print "exit"
        } else {
            print "disabled"
        }
    }
' "$config")

case "$mode" in
    client|exit)
        exec "$binary" --mode "$mode" --socket "$socket"
        ;;
    disabled)
        printf '%s\n' 'Native transport is not required: client and exit roles are disabled.'
        exit 0
        ;;
    combined)
        # Keep the existing socket as the Client endpoint. The Agent derives the same
        # second path for Exit operations; each native process retains one immutable role.
        client_pid=
        exit_pid=
        stop_workers() {
            trap '' HUP INT TERM
            [ -z "$client_pid" ] || kill -TERM "$client_pid" 2>/dev/null || :
            [ -z "$exit_pid" ] || kill -TERM "$exit_pid" 2>/dev/null || :
            [ -z "$client_pid" ] || wait "$client_pid" 2>/dev/null || :
            [ -z "$exit_pid" ] || wait "$exit_pid" 2>/dev/null || :
        }
        trap 'stop_workers; exit 0' HUP INT TERM
        "$binary" --mode client --socket "$socket" &
        client_pid=$!
        "$binary" --mode exit --socket "$socket.exit" &
        exit_pid=$!
        # A worker failure stops its companion and lets systemd restart the pair.
        # No worker is orphaned when the supervisor receives a shutdown signal.
        while kill -0 "$client_pid" 2>/dev/null && kill -0 "$exit_pid" 2>/dev/null; do
            sleep 1
        done
        stop_workers
        printf '%s\n' 'A native transport worker stopped; both roles have been stopped.' >&2
        exit 1
        ;;
    *)
        printf '%s\n' 'The roles.client and roles.exit configuration must each be true or false.' >&2
        exit 78
        ;;
esac
