+static int
+test_duplicate_and_mixed_teardown(void)
+{
+    test_env_t env;
+    raw_client_t first, replacement, idle, active;
+    raw_client_t *clients[MAX_TEST_CLIENTS] = {&first, &replacement, &idle, &active};
+    CHECK(env_start(&env, 2) == 0);
+    CHECK(client_start(&first, &env) == 0);
+    CHECK(pump_until_int(&env, clients, 1, &first.handshake_finished, 1) == 0);
+
+    raw_request_t *primary = client_open_connect_ip(&first);
+    CHECK(primary != NULL);
+    CHECK(pump_until_int(&env, clients, 1, &primary->status, 200) == 0);
+    CHECK(env.connected == 1);
+    CHECK(env.disconnected == 0);
+    CHECK(mqvpn_server_get_n_clients(env.server) == 1);
+
+    raw_request_t *duplicate = client_open_connect_ip(&first);
+    CHECK(duplicate != NULL);
+    CHECK(pump_until_int(&env, clients, 1, &duplicate->status, 409) == 0);
+    CHECK(env.connected == 1 && env.disconnected == 0);
+    CHECK(mqvpn_server_get_n_clients(env.server) == 1);
+
+    /* A rejected bidi stream can still upload after its 409 response. Its
+     * ADDRESS_REQUEST body and stream-scoped datagram must be drained/dropped,
+     * never answered or attributed to the primary owner's assignment. */
+    CHECK(client_send_address_request(duplicate) == 0);
+    CHECK(client_send_inner_datagram(duplicate) == 0);
+    for (int i = 0; i < 100; i++) pump_once(&env, clients, 1);
+    CHECK(duplicate->response_body_bytes == 0);
+    CHECK(env.inner_packets == 0);
+    CHECK(env.connected == 1 && env.disconnected == 0);
+    CHECK(mqvpn_server_get_n_clients(env.server) == 1);
+
+    CHECK(xqc_h3_request_close(duplicate->request) == XQC_OK);
+    CHECK(pump_until_int(&env, clients, 1, &duplicate->closed, 1) == 0);
+    CHECK(env.connected == 1 && env.disconnected == 0);
+    CHECK(mqvpn_server_get_n_clients(env.server) == 1);
+
+    CHECK(xqc_h3_request_close(primary->request) == XQC_OK);
+    CHECK(pump_until_int(&env, clients, 1, &env.disconnected, 1) == 0);
+    CHECK(mqvpn_server_get_n_clients(env.server) == 0);
+
+    /* The owner/resource teardown above must not clear the lifetime claim. */
+    raw_request_t *sequential = client_open_connect_ip(&first);
+    CHECK(sequential != NULL);
+    CHECK(pump_until_int(&env, clients, 1, &sequential->status, 409) == 0);
+    CHECK(env.connected == 1 && env.disconnected == 1);
+    CHECK(mqvpn_server_get_n_clients(env.server) == 0);
+
+    CHECK(xqc_h3_conn_close(first.engine, &first.cid) == XQC_OK);
+    CHECK(pump_until_int(&env, clients, 1, &first.closed, 1) == 0);
+    client_destroy(&first);
+
+    /* A new QUIC connection may consume the released admission/session
+     * capacity. The address pool deliberately advances its cursor, so exact
+     * immediate address equality is not part of its reuse contract. */
+    CHECK(client_start(&replacement, &env) == 0);
+    CHECK(pump_until_int(&env, clients + 1, 1, &replacement.handshake_finished, 1) ==
+          0);
+    raw_request_t *replacement_request = client_open_connect_ip(&replacement);
+    CHECK(replacement_request != NULL);
+    CHECK(pump_until_int(&env, clients + 1, 1, &replacement_request->status, 200) == 0);
+    CHECK(env.connected == 2 && env.disconnected == 1);
+    CHECK(env.last_session_id != 0);
+    CHECK(mqvpn_server_get_n_clients(env.server) == 1);
+
+    /* Connection-close is the second route into the same central teardown. */
+    CHECK(xqc_h3_conn_close(replacement.engine, &replacement.cid) == XQC_OK);
+    CHECK(pump_until_int(&env, clients + 1, 1, &env.disconnected, 2) == 0);
+    CHECK(mqvpn_server_get_n_clients(env.server) == 0);
+    client_destroy(&replacement);
+
+    /* Mixed destroy: one admitted H3-only connection plus one live session. */
+    CHECK(client_start(&idle, &env) == 0);
+    CHECK(pump_until_int(&env, clients + 2, 1, &idle.handshake_finished, 1) == 0);
+    CHECK(client_start(&active, &env) == 0);
+    CHECK(pump_until_int(&env, clients + 3, 1, &active.handshake_finished, 1) == 0);
+    raw_request_t *active_request = client_open_connect_ip(&active);
+    CHECK(active_request != NULL);
+    CHECK(pump_until_int(&env, clients + 3, 1, &active_request->status, 200) == 0);
+    CHECK(env.connected == 3 && mqvpn_server_get_n_clients(env.server) == 1);
+
+    mqvpn_server_destroy(env.server);
+    env.server = NULL;
+    CHECK(env.disconnected == 3);
+    client_destroy(&active);
+    client_destroy(&idle);
+    env_destroy(&env);
+    return 0;
+}
+
+static int
+test_max_clients_pre_auth_refuse_and_reuse(void)
+{
+    test_env_t env;
+    raw_client_t admitted, refused, reused;
+    raw_client_t *clients[MAX_TEST_CLIENTS] = {&admitted, &refused, &reused, NULL};
+    CHECK(env_start(&env, 1) == 0);
+
+    /* N=1: a handshaken H3 connection with no CONNECT request owns the slot. */
+    CHECK(client_start(&admitted, &env) == 0);
+    CHECK(pump_until_int(&env, clients, 1, &admitted.handshake_finished, 1) == 0);
+    CHECK(env.connected == 0 && mqvpn_server_get_n_clients(env.server) == 0);
+
+    /* N+1: refusal happens before H3/auth/session callbacks. */
+    CHECK(client_start(&refused, &env) == 0);
+    /* xquic's server_accept refusal is pre-H3 and may silently discard rather
+     * than reliably delivering an H3 close notify to the client. What is
+     * protocol-observable and stable is that repeated Initial/PTO traffic on
+     * loopback can never finish the second handshake while N is occupied. */
+    for (int i = 0; i < 1000 && !refused.handshake_finished; i++) {
+        pump_once(&env, clients, 2);
+    }
+    CHECK(refused.handshake_finished == 0);
+    CHECK(env.connected == 0 && env.disconnected == 0);
+    client_destroy(&refused);
+
+    /* Close the admitted pre-auth connection; the exact slot must be reusable. */
+    CHECK(xqc_h3_conn_close(admitted.engine, &admitted.cid) == XQC_OK);
+    CHECK(pump_until_int(&env, clients, 1, &admitted.closed, 1) == 0);
+    client_destroy(&admitted);
+
+    CHECK(client_start(&reused, &env) == 0);
+    CHECK(pump_until_int(&env, clients + 2, 1, &reused.handshake_finished, 1) == 0);
+    raw_request_t *request = client_open_connect_ip(&reused);
+    CHECK(request != NULL);
+    CHECK(pump_until_int(&env, clients + 2, 1, &request->status, 200) == 0);
+    CHECK(env.connected == 1 && mqvpn_server_get_n_clients(env.server) == 1);
+
+    CHECK(xqc_h3_conn_close(reused.engine, &reused.cid) == XQC_OK);
+    CHECK(pump_until_int(&env, clients + 2, 1, &env.disconnected, 1) == 0);
+    CHECK(mqvpn_server_get_n_clients(env.server) == 0);
+    client_destroy(&reused);
+    env_destroy(&env);
+    return 0;
+}
+
+static int
+test_pre_h3_alpn_refuse_releases_capacity(void)
+{
+    test_env_t env;
+    raw_client_t unsupported, reused;
+    raw_client_t *clients[MAX_TEST_CLIENTS] = {&unsupported, &reused, NULL, NULL};
+    CHECK(env_start(&env, 1) == 0);
+
+    /* server_accept reserves the only slot and binds mqvpn's context. The
+     * unsupported ALPN then closes before H3 exists, so only cb_refuse can
+     * release that reservation/context. */
+    CHECK(client_start_unsupported_alpn(&unsupported, &env) == 0);
+    CHECK(pump_until_int(&env, clients, 1, &unsupported.closed, 1) == 0);
+    CHECK(env.connected == 0 && env.disconnected == 0);
+    CHECK(mqvpn_server_get_n_clients(env.server) == 0);
+    client_destroy(&unsupported);
+
+    /* If cb_refuse leaked the admission slot, this ordinary H3 handshake can
+     * never complete at MaxClients=1. Reaching a CONNECT-IP 200 proves reuse. */
+    CHECK(client_start(&reused, &env) == 0);
+    CHECK(pump_until_int(&env, clients + 1, 1, &reused.handshake_finished, 1) == 0);
+    raw_request_t *request = client_open_connect_ip(&reused);
+    CHECK(request != NULL);
+    CHECK(pump_until_int(&env, clients + 1, 1, &request->status, 200) == 0);
+    CHECK(env.connected == 1 && mqvpn_server_get_n_clients(env.server) == 1);
+
+    CHECK(xqc_h3_conn_close(reused.engine, &reused.cid) == XQC_OK);
+    CHECK(pump_until_int(&env, clients + 1, 1, &env.disconnected, 1) == 0);
+    CHECK(mqvpn_server_get_n_clients(env.server) == 0);
+    client_destroy(&reused);
+    env_destroy(&env);
+    return 0;
+}
+
+int
+main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+    setvbuf(stderr, NULL, _IONBF, 0);
+    printf("test_server_adversarial: raw QUIC/H3 lifecycle regressions\n");
+    if (test_duplicate_and_mixed_teardown() != 0 ||
+        test_max_clients_pre_auth_refuse_and_reuse() != 0 ||
+        test_pre_h3_alpn_refuse_releases_capacity() != 0) {
+        fprintf(stderr, "test_server_adversarial: FAILED\n");
+        return 1;
+    }
+    printf("test_server_adversarial: PASS\n");
+    return 0;
+}
diff --git a/tests/test_server_hardening.c b/tests/test_server_hardening.c
new file mode 100644
index 0000000..e57010f
--- /dev/null
+++ b/tests/test_server_hardening.c
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+#include "server_hardening.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#define ASSERT_TRUE(condition)                                              \
+    do {                                                                    \
+        if (!(condition)) {                                                 \
+            fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__,       \
+                    #condition);                                            \
+            return 1;                                                       \
+        }                                                                   \
+    } while (0)
+
+static int
+test_pending_connection_cap(void)
+{
+    mqvpn_server_admission_t admission;
+    ASSERT_TRUE(mqvpn_server_admission_init(&admission, 1) == 0);
+    ASSERT_TRUE(mqvpn_server_admission_reserve(&admission) == 0);
+    ASSERT_TRUE(admission.in_use == 1);
+    ASSERT_TRUE(mqvpn_server_admission_reserve(&admission) != 0);
+    ASSERT_TRUE(admission.in_use == 1);
+    ASSERT_TRUE(mqvpn_server_admission_release(&admission) == 0);
+    ASSERT_TRUE(admission.in_use == 0);
+    ASSERT_TRUE(mqvpn_server_admission_release(&admission) != 0);
+    ASSERT_TRUE(admission.in_use == 0);
+    ASSERT_TRUE(mqvpn_server_admission_reserve(&admission) == 0);
+    ASSERT_TRUE(admission.in_use == 1);
+    return 0;
+}
+
+static int
+test_connection_cap_bounds(void)
+{
+    mqvpn_server_admission_t admission;
+    ASSERT_TRUE(mqvpn_server_admission_init(NULL, 1) != 0);
+    ASSERT_TRUE(mqvpn_server_admission_init(&admission, 0) != 0);
+    ASSERT_TRUE(mqvpn_server_admission_init(
+                    &admission, MQVPN_SERVER_CONNECTION_LIMIT_MAX + 1U) != 0);
+    ASSERT_TRUE(mqvpn_server_admission_init(
+                    &admission, MQVPN_SERVER_CONNECTION_LIMIT_MAX) == 0);
+    for (uint32_t i = 0; i < MQVPN_SERVER_CONNECTION_LIMIT_MAX; i++) {
+        ASSERT_TRUE(mqvpn_server_admission_reserve(&admission) == 0);
+    }
+    ASSERT_TRUE(mqvpn_server_admission_reserve(&admission) != 0);
+    return 0;
+}
+
+static int
+test_ipv4_peer_pin(void)
+{
+    mqvpn_server_peer_pin_t pin;
+    memset(&pin, 0, sizeof(pin));
+    struct sockaddr_in peer;
+    memset(&peer, 0, sizeof(peer));
+    peer.sin_family = AF_INET;
+    peer.sin_port = htons(443);
+    peer.sin_addr.s_addr = htonl(0xc0000201U);
+
+    ASSERT_TRUE(mqvpn_server_peer_pin_set(&pin, (const struct sockaddr *)&peer,
+                                          sizeof(peer)) == 0);
+    ASSERT_TRUE(mqvpn_server_peer_pin_matches(
+                    &pin, (const struct sockaddr *)&peer, sizeof(peer)) == 1);
+
+    struct sockaddr_in other = peer;
+    other.sin_port = htons(444);
+    ASSERT_TRUE(mqvpn_server_peer_pin_matches(
+                    &pin, (const struct sockaddr *)&other, sizeof(other)) == 0);
+    other = peer;
+    other.sin_addr.s_addr = htonl(0xc0000202U);
+    ASSERT_TRUE(mqvpn_server_peer_pin_matches(
+                    &pin, (const struct sockaddr *)&other, sizeof(other)) == 0);
+
+    peer.sin_port = 0;
+    ASSERT_TRUE(mqvpn_server_peer_pin_set(&pin, (const struct sockaddr *)&peer,
+                                          sizeof(peer)) != 0);
+    ASSERT_TRUE(mqvpn_server_peer_pin_matches(
+                    &pin, (const struct sockaddr *)&other, sizeof(other)) == 0);
+    return 0;
+}
+
+static int
+test_ipv6_peer_pin(void)
+{
+    mqvpn_server_peer_pin_t pin;
+    memset(&pin, 0, sizeof(pin));
+    struct sockaddr_in6 peer;
+    memset(&peer, 0, sizeof(peer));
+    peer.sin6_family = AF_INET6;
+    peer.sin6_port = htons(8443);
+    peer.sin6_scope_id = 7;
+    peer.sin6_addr.s6_addr[0] = 0x20;
+    peer.sin6_addr.s6_addr[1] = 0x01;
+    peer.sin6_addr.s6_addr[2] = 0x0d;
+    peer.sin6_addr.s6_addr[3] = 0xb8;
+    peer.sin6_addr.s6_addr[15] = 1;
+
+    ASSERT_TRUE(mqvpn_server_peer_pin_set(&pin, (const struct sockaddr *)&peer,
+                                          sizeof(peer)) == 0);
+    ASSERT_TRUE(mqvpn_server_peer_pin_matches(
+                    &pin, (const struct sockaddr *)&peer, sizeof(peer)) == 1);
+
+    struct sockaddr_in6 other = peer;
+    other.sin6_scope_id = 8;
+    ASSERT_TRUE(mqvpn_server_peer_pin_matches(
+                    &pin, (const struct sockaddr *)&other, sizeof(other)) == 0);
+    other = peer;
+    other.sin6_addr.s6_addr[15] = 2;
+    ASSERT_TRUE(mqvpn_server_peer_pin_matches(
+                    &pin, (const struct sockaddr *)&other, sizeof(other)) == 0);
+
+    socklen_t selected_len = 0;
+    const struct sockaddr *selected =
+        mqvpn_server_peer_pin_addr(&pin, &selected_len);
+    ASSERT_TRUE(selected != NULL);
+    ASSERT_TRUE(selected_len == sizeof(struct sockaddr_in6));
+    ASSERT_TRUE(mqvpn_server_peer_pin_matches(&pin, selected, selected_len) == 1);
+    return 0;
+}
+
+int
+main(void)
+{
+    int failed = 0;
+    failed += test_pending_connection_cap();
+    failed += test_connection_cap_bounds();
+    failed += test_ipv4_peer_pin();
+    failed += test_ipv6_peer_pin();
+    if (failed != 0) {
+        fprintf(stderr, "test_server_hardening: FAILED\n");
+        return 1;
+    }
+    printf("test_server_hardening: PASS\n");
+    return 0;
+}
diff --git a/tests/test_spki_pin.c b/tests/test_spki_pin.c
new file mode 100644
index 0000000..77b9a8d
--- /dev/null
+++ b/tests/test_spki_pin.c
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+#ifdef NDEBUG
+#  undef NDEBUG
+#endif
+
+#include "spki_pin.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <openssl/pem.h>
+#include <openssl/x509.h>
+
+static uint8_t *
+load_test_certificate(size_t *out_len)
+{
+    FILE *stream = fopen(TEST_CERT_FILE, "rb");
+    assert(stream != NULL);
+    X509 *certificate = PEM_read_X509(stream, NULL, NULL, NULL);
+    assert(fclose(stream) == 0);
+    assert(certificate != NULL);
+
+    const int der_len = i2d_X509(certificate, NULL);
+    assert(der_len > 0);
+    uint8_t *der = malloc((size_t)der_len);
+    assert(der != NULL);
+    uint8_t *cursor = der;
+    assert(i2d_X509(certificate, &cursor) == der_len);
+    assert(cursor == der + der_len);
+    X509_free(certificate);
+    *out_len = (size_t)der_len;
+    return der;
+}
+
+static void
+test_known_fixture_pin(void)
+{
+    static const uint8_t expected[MQVPN_SPKI_SHA256_LEN] = {
+        0xa0, 0xfc, 0x6a, 0x29, 0x4f, 0x07, 0x24, 0x82,
+        0x11, 0xdf, 0xb2, 0x68, 0xb4, 0x3a, 0x00, 0x7d,
+        0x9f, 0x8b, 0x2d, 0xa2, 0x4d, 0xf6, 0xee, 0x83,
+        0x69, 0xe9, 0x21, 0xc4, 0xdd, 0x58, 0x89, 0xc8,
+    };
+    size_t der_len = 0;
+    uint8_t *der = load_test_certificate(&der_len);
+    uint8_t actual[MQVPN_SPKI_SHA256_LEN];
+    assert(mqvpn_spki_sha256_from_leaf_der(der, der_len, actual) == 0);
+    assert(memcmp(actual, expected, sizeof(actual)) == 0);
+    assert(mqvpn_spki_pin_matches_leaf_der(der, der_len, expected) == 1);
+
+    actual[0] ^= 1;
+    assert(mqvpn_spki_pin_matches_leaf_der(der, der_len, actual) == 0);
+    free(der);
+}
+
+static void
+test_malformed_and_oversize_fail_closed(void)
+{
+    const uint8_t malformed[] = {0x30, 0x03, 0x01, 0x01, 0xff};
+    uint8_t output[MQVPN_SPKI_SHA256_LEN];
+    memset(output, 0xa5, sizeof(output));
+    assert(mqvpn_spki_sha256_from_leaf_der(malformed, sizeof(malformed), output) == -1);
+    assert(mqvpn_spki_pin_matches_leaf_der(malformed, sizeof(malformed), output) == 0);
+    assert(mqvpn_spki_sha256_from_leaf_der(NULL, 1, output) == -1);
+    assert(mqvpn_spki_sha256_from_leaf_der(malformed,
+                                           MQVPN_MAX_LEAF_CERT_DER_LEN + 1U,
+                                           output) == -1);
+}
+
+int
+main(void)
+{
+    test_known_fixture_pin();
+    test_malformed_and_oversize_fail_closed();
+    puts("SPKI pin tests passed");
+    return 0;
+}
