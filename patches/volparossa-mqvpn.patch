new file mode 100644
index 0000000..1af7ce3
--- /dev/null
+++ b/tests/test_server_adversarial.c
@@ -0,0 +1,903 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+/*
+ * Real QUIC/H3 adversarial lifecycle coverage for server admission and
+ * CONNECT-IP ownership. This deliberately uses raw xquic H3 clients rather
+ * than mqvpn's one-request client wrapper, so one connection can attempt
+ * concurrent and sequential duplicate CONNECT-IP streams and another can
+ * remain handshaken but unauthenticated at the MaxClients boundary.
+ *
+ * VOLPAROSSA's product configuration will use one exact pinned peer and
+ * MaxClients=1 per exit association. Hard-coding that product policy into
+ * general-purpose upstream mqvpn is explicitly not this patch's job; this
+ * test uses the legacy unpinned compatibility socket solely to exercise the
+ * upstream N/N+1 admission invariant with independent loopback peers.
+ */
+
+#include "libmqvpn.h"
+#include "mqvpn_conn_settings.h"
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <poll.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+#include <xquic/xqc_http3.h>
+#include <xquic/xquic.h>
+#include <xquic/xquic_typedef.h>
+
+#define MAX_TEST_CLIENTS 4
+#define MAX_TEST_REQUESTS 5
+#define PUMP_LIMIT 5000
+
+#define CHECK(condition)                                                        \
+    do {                                                                        \
+        if (!(condition)) {                                                     \
+            fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__,          \
+                    #condition);                                                \
+            return -1;                                                          \
+        }                                                                       \
+    } while (0)
+
+typedef struct test_env_s test_env_t;
+typedef struct raw_client_s raw_client_t;
+
+typedef struct {
+    raw_client_t *client;
+    xqc_h3_request_t *request;
+    int status;
+    int response_headers;
+    size_t response_body_bytes;
+    int closed;
+    uint64_t stream_id;
+} raw_request_t;
+
+struct raw_client_s {
+    test_env_t *env;
+    xqc_engine_t *engine;
+    int fd;
+    struct sockaddr_in local_addr;
+    xqc_cid_t cid;
+    xqc_h3_conn_t *h3_conn;
+    int handshake_finished;
+    int closed;
+    raw_request_t requests[MAX_TEST_REQUESTS];
+    int n_requests;
+};
+
+struct test_env_s {
+    mqvpn_server_t *server;
+    int server_fd;
+    struct sockaddr_in server_addr;
+    int connected;
+    int disconnected;
+    uint32_t last_session_id;
+    uint8_t last_assigned_ip[4];
+    int inner_packets;
+};
+
+static xqc_usec_t
+test_now_us(void)
+{
+    struct timeval time_value;
+    gettimeofday(&time_value, NULL);
+    return (xqc_usec_t)time_value.tv_sec * 1000000 + (xqc_usec_t)time_value.tv_usec;
+}
+
+static int
+make_loopback_socket(struct sockaddr_in *addr)
+{
+    int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd < 0) return -1;
+    int flags = fcntl(fd, F_GETFL, 0);
+    if (flags < 0 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) != 0) {
+        close(fd);
+        return -1;
+    }
+
+    memset(addr, 0, sizeof(*addr));
+    addr->sin_family = AF_INET;
+    addr->sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    addr->sin_port = 0;
+    if (bind(fd, (struct sockaddr *)addr, sizeof(*addr)) != 0) {
+        close(fd);
+        return -1;
+    }
+    socklen_t len = sizeof(*addr);
+    if (getsockname(fd, (struct sockaddr *)addr, &len) != 0) {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+static void
+server_tun_output(const uint8_t *packet, size_t length, void *user_ctx)
+{
+    (void)packet;
+    (void)length;
+    (void)user_ctx;
+}
+
+static void
+server_tunnel_config_ready(const mqvpn_tunnel_info_t *info, void *user_ctx)
+{
+    (void)info;
+    (void)user_ctx;
+}
+
+static void
+server_session_tun_output(const uint8_t *packet, size_t length, uint32_t session_id,
+                          void *user_ctx)
+{
+    test_env_t *env = (test_env_t *)user_ctx;
+    (void)packet;
+    (void)length;
+    (void)session_id;
+    env->inner_packets++;
+}
+
+static void
+server_client_connected(const mqvpn_tunnel_info_t *info, uint32_t session_id,
+                        void *user_ctx)
+{
+    test_env_t *env = (test_env_t *)user_ctx;
+    env->connected++;
+    env->last_session_id = session_id;
+    if (info) memcpy(env->last_assigned_ip, info->assigned_ip, 4);
+}
+
+static void
+server_client_disconnected(uint32_t session_id, mqvpn_error_t reason, void *user_ctx)
+{
+    test_env_t *env = (test_env_t *)user_ctx;
+    (void)session_id;
+    (void)reason;
+    env->disconnected++;
+}
+
+static int
+env_start(test_env_t *env, int max_clients)
+{
+    memset(env, 0, sizeof(*env));
+    env->server_fd = -1;
+    env->server_fd = make_loopback_socket(&env->server_addr);
+    CHECK(env->server_fd >= 0);
+
+    mqvpn_config_t *config = mqvpn_config_new();
+    CHECK(config != NULL);
+    CHECK(mqvpn_config_set_listen(config, "127.0.0.1",
+                                  ntohs(env->server_addr.sin_port)) == MQVPN_OK);
+    CHECK(mqvpn_config_set_subnet(config, "10.77.0.0/24") == MQVPN_OK);
+    CHECK(mqvpn_config_set_tls_cert(config, TEST_CERT_FILE, TEST_KEY_FILE) == MQVPN_OK);
+    CHECK(mqvpn_config_set_max_clients(config, max_clients) == MQVPN_OK);
+    CHECK(mqvpn_config_set_log_level(config, MQVPN_LOG_ERROR) == MQVPN_OK);
+
+    mqvpn_server_callbacks_t callbacks = MQVPN_SERVER_CALLBACKS_INIT;
+    callbacks.tun_output = server_tun_output;
+    callbacks.tunnel_config_ready = server_tunnel_config_ready;
+    callbacks.session_tun_output = server_session_tun_output;
+    callbacks.on_client_connected = server_client_connected;
+    callbacks.on_client_disconnected = server_client_disconnected;
+    env->server = mqvpn_server_new(config, &callbacks, env);
+    mqvpn_config_free(config);
+    CHECK(env->server != NULL);
+    CHECK(mqvpn_server_set_socket_fd(env->server, env->server_fd,
+                                     (struct sockaddr *)&env->server_addr,
+                                     sizeof(env->server_addr)) == MQVPN_OK);
+    CHECK(mqvpn_server_start(env->server) == MQVPN_OK);
+    return 0;
+}
