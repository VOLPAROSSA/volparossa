+static ssize_t
+client_write_socket(const unsigned char *buffer, size_t size,
+                    const struct sockaddr *peer, socklen_t peer_len,
+                    void *conn_user_data)
+{
+    raw_client_t *client = (raw_client_t *)conn_user_data;
+    if (!client || client->fd < 0) return XQC_SOCKET_ERROR;
+    ssize_t written;
+    do {
+        written = sendto(client->fd, buffer, size, 0, peer, peer_len);
+    } while (written < 0 && errno == EINTR);
+    if (written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+        return XQC_SOCKET_EAGAIN;
+    }
+    return written < 0 ? XQC_SOCKET_ERROR : written;
+}
