+static uint8_t *
+read_fixture(const char *path, size_t maximum, size_t *out_len)
+{
+    FILE *stream = fopen(path, "rb");
+    if (stream == NULL || fseek(stream, 0, SEEK_END) != 0) {
+        if (stream != NULL) fclose(stream);
+        return NULL;
+    }
+    long file_len = ftell(stream);
+    if (file_len <= 0 || (size_t)file_len > maximum ||
+        fseek(stream, 0, SEEK_SET) != 0) {
+        fclose(stream);
+        return NULL;
+    }
+
+    uint8_t *contents = malloc((size_t)file_len);
+    if (contents == NULL ||
+        fread(contents, 1U, (size_t)file_len, stream) != (size_t)file_len ||
+        fgetc(stream) != EOF || ferror(stream)) {
+        if (contents != NULL) {
+            mqvpn_secure_zero(contents, (size_t)file_len);
+            free(contents);
+        }
+        fclose(stream);
+        return NULL;
+    }
+    fclose(stream);
+    *out_len = (size_t)file_len;
+    return contents;
+}
