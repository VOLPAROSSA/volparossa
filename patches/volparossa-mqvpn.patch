+static raw_request_t *
+client_open_connect_ip(raw_client_t *client)
+{
+    if (!client || !client->engine || !client->handshake_finished ||
+        client->n_requests >= MAX_TEST_REQUESTS)
+        return NULL;
+
+    raw_request_t *test_request = &client->requests[client->n_requests++];
+    memset(test_request, 0, sizeof(*test_request));
+    test_request->client = client;
+    test_request->request =
+        xqc_h3_request_create(client->engine, &client->cid, NULL, test_request);
+    if (!test_request->request) return NULL;
+    test_request->stream_id = xqc_h3_stream_id(test_request->request);
+
+    xqc_http_header_t headers[] = {
+        {.name = {.iov_base = ":method", .iov_len = 7},
+         .value = {.iov_base = "CONNECT", .iov_len = 7}},
+        {.name = {.iov_base = ":protocol", .iov_len = 9},
+         .value = {.iov_base = "connect-ip", .iov_len = 10}},
+        {.name = {.iov_base = ":scheme", .iov_len = 7},
+         .value = {.iov_base = "https", .iov_len = 5}},
+        {.name = {.iov_base = ":authority", .iov_len = 10},
+         .value = {.iov_base = "mqvpn.invalid", .iov_len = 13}},
+        {.name = {.iov_base = ":path", .iov_len = 5},
+         .value = {.iov_base = "/.well-known/masque/ip/example.test/443/",
+                   .iov_len = sizeof("/.well-known/masque/ip/example.test/443/") - 1}},
+        {.name = {.iov_base = "capsule-protocol", .iov_len = 16},
+         .value = {.iov_base = "?1", .iov_len = 2}},
+    };
+    xqc_http_headers_t request_headers = {
+        .headers = headers,
+        .count = sizeof(headers) / sizeof(headers[0]),
+        .capacity = sizeof(headers) / sizeof(headers[0]),
+    };
+    if (xqc_h3_request_send_headers(test_request->request, &request_headers, 0) < 0) {
+        return NULL;
+    }
+    return test_request;
+}
