diff --git a/src/server_hardening.c b/src/server_hardening.c
new file mode 100644
index 0000000..24eec0f
--- /dev/null
+++ b/src/server_hardening.c
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+#include "server_hardening.h"
+
+#include <string.h>
+
+int
+mqvpn_server_admission_init(mqvpn_server_admission_t *admission,
+                            uint32_t limit)
+{
+    if (admission == NULL || limit == 0 ||
+        limit > MQVPN_SERVER_CONNECTION_LIMIT_MAX) {
+        return -1;
+    }
+    admission->limit = limit;
+    admission->in_use = 0;
+    return 0;
+}
+
+int
+mqvpn_server_admission_reserve(mqvpn_server_admission_t *admission)
+{
+    if (admission == NULL || admission->limit == 0 ||
+        admission->in_use >= admission->limit) {
+        return -1;
+    }
+    admission->in_use++;
+    return 0;
+}
+
+int
+mqvpn_server_admission_release(mqvpn_server_admission_t *admission)
+{
+    if (admission == NULL || admission->in_use == 0) return -1;
+    admission->in_use--;
+    return 0;
+}
+
+static int
+mqvpn_server_peer_canonicalize(struct sockaddr_storage *out,
+                               socklen_t *out_len,
+                               const struct sockaddr *peer,
+                               socklen_t peer_len)
+{
+    if (out == NULL || out_len == NULL || peer == NULL) return -1;
+    memset(out, 0, sizeof(*out));
+
+    if (peer->sa_family == AF_INET) {
+        if (peer_len != (socklen_t)sizeof(struct sockaddr_in)) return -1;
+        const struct sockaddr_in *source =
+            (const struct sockaddr_in *)peer;
+        if (source->sin_port == 0 ||
+            source->sin_addr.s_addr == htonl(INADDR_ANY) ||
+            source->sin_addr.s_addr == htonl(INADDR_BROADCAST) ||
+            IN_MULTICAST(ntohl(source->sin_addr.s_addr))) {
+            return -1;
+        }
+        struct sockaddr_in *destination = (struct sockaddr_in *)out;
+        destination->sin_family = AF_INET;
+        destination->sin_port = source->sin_port;
+        destination->sin_addr = source->sin_addr;
+        *out_len = (socklen_t)sizeof(*destination);
+        return 0;
+    }
+
+    if (peer->sa_family == AF_INET6) {
+        if (peer_len != (socklen_t)sizeof(struct sockaddr_in6)) return -1;
+        const struct sockaddr_in6 *source =
+            (const struct sockaddr_in6 *)peer;
+        if (source->sin6_port == 0 ||
+            IN6_IS_ADDR_UNSPECIFIED(&source->sin6_addr) ||
+            IN6_IS_ADDR_MULTICAST(&source->sin6_addr)) {
+            return -1;
+        }
+        struct sockaddr_in6 *destination = (struct sockaddr_in6 *)out;
+        destination->sin6_family = AF_INET6;
+        destination->sin6_port = source->sin6_port;
+        destination->sin6_addr = source->sin6_addr;
+        destination->sin6_scope_id = source->sin6_scope_id;
+        *out_len = (socklen_t)sizeof(*destination);
+        return 0;
+    }
+
+    return -1;
+}
+
+int
+mqvpn_server_peer_pin_set(mqvpn_server_peer_pin_t *pin,
+                          const struct sockaddr *peer,
+                          socklen_t peer_len)
+{
+    if (pin == NULL) return -1;
+    mqvpn_server_peer_pin_t candidate;
+    memset(&candidate, 0, sizeof(candidate));
+    if (mqvpn_server_peer_canonicalize(&candidate.addr, &candidate.addrlen,
+                                       peer, peer_len) != 0) {
+        return -1;
+    }
+    candidate.configured = 1;
+    *pin = candidate;
+    return 0;
+}
+
+int
+mqvpn_server_peer_pin_matches(const mqvpn_server_peer_pin_t *pin,
+                              const struct sockaddr *peer,
+                              socklen_t peer_len)
+{
+    if (pin == NULL || !pin->configured) return 0;
+    struct sockaddr_storage candidate;
+    socklen_t candidate_len = 0;
+    if (mqvpn_server_peer_canonicalize(&candidate, &candidate_len, peer,
+                                       peer_len) != 0 ||
+        candidate_len != pin->addrlen) {
+        return 0;
+    }
+    return memcmp(&candidate, &pin->addr, candidate_len) == 0;
+}
+
+const struct sockaddr *
+mqvpn_server_peer_pin_addr(const mqvpn_server_peer_pin_t *pin,
+                           socklen_t *peer_len)
+{
+    if (pin == NULL || !pin->configured || peer_len == NULL) return NULL;
+    *peer_len = pin->addrlen;
+    return (const struct sockaddr *)&pin->addr;
+}
