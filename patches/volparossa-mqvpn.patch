diff --git a/tests/test_spki_pin.c b/tests/test_spki_pin.c
new file mode 100644
index 0000000..77b9a8d
--- /dev/null
+++ b/tests/test_spki_pin.c
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+#ifdef NDEBUG
+#  undef NDEBUG
+#endif
+
+#include "spki_pin.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <openssl/pem.h>
+#include <openssl/x509.h>
+
+static uint8_t *
+load_test_certificate(size_t *out_len)
+{
+    FILE *stream = fopen(TEST_CERT_FILE, "rb");
+    assert(stream != NULL);
+    X509 *certificate = PEM_read_X509(stream, NULL, NULL, NULL);
+    assert(fclose(stream) == 0);
+    assert(certificate != NULL);
+
+    const int der_len = i2d_X509(certificate, NULL);
+    assert(der_len > 0);
+    uint8_t *der = malloc((size_t)der_len);
+    assert(der != NULL);
+    uint8_t *cursor = der;
+    assert(i2d_X509(certificate, &cursor) == der_len);
+    assert(cursor == der + der_len);
+    X509_free(certificate);
+    *out_len = (size_t)der_len;
+    return der;
+}
+
+static void
+test_known_fixture_pin(void)
+{
+    static const uint8_t expected[MQVPN_SPKI_SHA256_LEN] = {
+        0xa0, 0xfc, 0x6a, 0x29, 0x4f, 0x07, 0x24, 0x82,
+        0x11, 0xdf, 0xb2, 0x68, 0xb4, 0x3a, 0x00, 0x7d,
+        0x9f, 0x8b, 0x2d, 0xa2, 0x4d, 0xf6, 0xee, 0x83,
+        0x69, 0xe9, 0x21, 0xc4, 0xdd, 0x58, 0x89, 0xc8,
+    };
+    size_t der_len = 0;
+    uint8_t *der = load_test_certificate(&der_len);
+    uint8_t actual[MQVPN_SPKI_SHA256_LEN];
+    assert(mqvpn_spki_sha256_from_leaf_der(der, der_len, actual) == 0);
+    assert(memcmp(actual, expected, sizeof(actual)) == 0);
+    assert(mqvpn_spki_pin_matches_leaf_der(der, der_len, expected) == 1);
+
+    actual[0] ^= 1;
+    assert(mqvpn_spki_pin_matches_leaf_der(der, der_len, actual) == 0);
+    free(der);
+}
+
+static void
+test_malformed_and_oversize_fail_closed(void)
+{
+    const uint8_t malformed[] = {0x30, 0x03, 0x01, 0x01, 0xff};
+    uint8_t output[MQVPN_SPKI_SHA256_LEN];
+    memset(output, 0xa5, sizeof(output));
+    assert(mqvpn_spki_sha256_from_leaf_der(malformed, sizeof(malformed), output) == -1);
+    assert(mqvpn_spki_pin_matches_leaf_der(malformed, sizeof(malformed), output) == 0);
+    assert(mqvpn_spki_sha256_from_leaf_der(NULL, 1, output) == -1);
+    assert(mqvpn_spki_sha256_from_leaf_der(malformed,
+                                           MQVPN_MAX_LEAF_CERT_DER_LEN + 1U,
+                                           output) == -1);
+}
+
+int
+main(void)
+{
+    test_known_fixture_pin();
+    test_malformed_and_oversize_fail_closed();
+    puts("SPKI pin tests passed");
+    return 0;
+}
