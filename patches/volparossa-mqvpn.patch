+static int
+client_request_read(xqc_h3_request_t *request, xqc_request_notify_flag_t flag,
+                    void *user_data)
+{
+    raw_request_t *test_request = (raw_request_t *)user_data;
+    if (!test_request) return -1;
+
+    if (flag & XQC_REQ_NOTIFY_READ_HEADER) {
+        unsigned char fin = 0;
+        xqc_http_headers_t *headers = xqc_h3_request_recv_headers(request, &fin);
+        if (!headers) return -1;
+        test_request->response_headers++;
+        for (size_t i = 0; i < headers->count; i++) {
+            xqc_http_header_t *header = &headers->headers[i];
+            if (header->name.iov_len == 7 &&
+                memcmp(header->name.iov_base, ":status", 7) == 0 &&
+                header->value.iov_len == 3) {
+                const unsigned char *value = header->value.iov_base;
+                if (value[0] >= '0' && value[0] <= '9' && value[1] >= '0' &&
+                    value[1] <= '9' && value[2] >= '0' && value[2] <= '9') {
+                    test_request->status =
+                        (value[0] - '0') * 100 + (value[1] - '0') * 10 +
+                        (value[2] - '0');
+                }
+            }
+        }
+    }
+
+    if (flag & XQC_REQ_NOTIFY_READ_BODY) {
+        unsigned char body[2048];
+        unsigned char fin = 0;
+        for (;;) {
+            ssize_t count = xqc_h3_request_recv_body(request, body, sizeof(body), &fin);
+            if (count <= 0) break;
+            test_request->response_body_bytes += (size_t)count;
+        }
+    }
+    return 0;
+}
