+static int
+client_send_address_request(raw_request_t *request)
+{
+    uint8_t requested_ip[4] = {0};
+    uint8_t payload[64];
+    size_t payload_len = 0;
+    if (!request || !request->request ||
+        xqc_h3_ext_connectip_build_address_request(
+            payload, sizeof(payload), &payload_len, 7, 4, requested_ip, 0) != XQC_OK) {
+        return -1;
+    }
+    uint8_t capsule[128];
+    size_t capsule_len = 0;
+    if (xqc_h3_ext_capsule_encode(capsule, sizeof(capsule), &capsule_len,
+                                  XQC_H3_CAPSULE_ADDRESS_REQUEST, payload,
+                                  payload_len) != XQC_OK) {
+        return -1;
+    }
+    return xqc_h3_request_send_body(request->request, capsule, capsule_len, 0) < 0
+               ? -1
+               : 0;
+}
+
+static int
+client_send_inner_datagram(raw_request_t *request)
+{
+    if (!request || !request->client || !request->client->h3_conn) return -1;
+    uint8_t inner[20] = {0x45};
+    inner[2] = 0;
+    inner[3] = sizeof(inner);
+    inner[8] = 64;
+    inner[9] = 17;
+    memcpy(&inner[12], request->client->env->last_assigned_ip,
+           sizeof(request->client->env->last_assigned_ip));
+    inner[16] = 192;
+    inner[17] = 0;
+    inner[18] = 2;
+    inner[19] = 1;
+    uint8_t framed[128];
+    size_t framed_len = 0;
+    if (xqc_h3_ext_masque_frame_udp(framed, sizeof(framed), &framed_len,
+                                    request->stream_id, inner, sizeof(inner)) != XQC_OK) {
+        return -1;
+    }
+    uint64_t datagram_id = 0;
+    return xqc_h3_ext_datagram_send(request->client->h3_conn, framed, framed_len,
+                                    &datagram_id, XQC_DATA_QOS_HIGH) == XQC_OK
+               ? 0
+               : -1;
+}
