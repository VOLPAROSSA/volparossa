diff --git a/src/spki_pin.c b/src/spki_pin.c
new file mode 100644
index 0000000..bb7ec91
--- /dev/null
+++ b/src/spki_pin.c
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+#include "spki_pin.h"
+
+#include <limits.h>
+#include <stdlib.h>
+
+#include <openssl/mem.h>
+#include <openssl/sha.h>
+#include <openssl/x509.h>
+
+int
+mqvpn_spki_sha256_from_leaf_der(const uint8_t *der, size_t der_len,
+                                uint8_t out[MQVPN_SPKI_SHA256_LEN])
+{
+    if (der == NULL || out == NULL || der_len == 0
+        || der_len > MQVPN_MAX_LEAF_CERT_DER_LEN || der_len > (size_t)LONG_MAX)
+    {
+        return -1;
+    }
+
+    const uint8_t *cursor = der;
+    X509 *certificate = d2i_X509(NULL, &cursor, (long)der_len);
+    if (certificate == NULL || cursor != der + der_len) {
+        X509_free(certificate);
+        return -1;
+    }
+
+    X509_PUBKEY *public_key = X509_get_X509_PUBKEY(certificate);
+    if (public_key == NULL) {
+        X509_free(certificate);
+        return -1;
+    }
+
+    const int encoded_len = i2d_X509_PUBKEY(public_key, NULL);
+    if (encoded_len <= 0) {
+        X509_free(certificate);
+        return -1;
+    }
+
+    uint8_t *encoded = malloc((size_t)encoded_len);
+    if (encoded == NULL) {
+        X509_free(certificate);
+        return -1;
+    }
+    uint8_t *encoded_cursor = encoded;
+    const int written = i2d_X509_PUBKEY(public_key, &encoded_cursor);
+    if (written != encoded_len || encoded_cursor != encoded + encoded_len) {
+        OPENSSL_cleanse(encoded, (size_t)encoded_len);
+        free(encoded);
+        X509_free(certificate);
+        return -1;
+    }
+
+    const int result = SHA256(encoded, (size_t)encoded_len, out) != NULL ? 0 : -1;
+    OPENSSL_cleanse(encoded, (size_t)encoded_len);
+    free(encoded);
+    X509_free(certificate);
+    return result;
+}
+
+int
+mqvpn_spki_pin_matches_leaf_der(const uint8_t *der, size_t der_len,
+                                const uint8_t expected[MQVPN_SPKI_SHA256_LEN])
+{
+    uint8_t actual[MQVPN_SPKI_SHA256_LEN] = {0};
+    if (expected == NULL) return 0;
+    if (mqvpn_spki_sha256_from_leaf_der(der, der_len, actual) != 0) {
+        OPENSSL_cleanse(actual, sizeof(actual));
+        return 0;
+    }
+    const int matches = CRYPTO_memcmp(actual, expected, sizeof(actual)) == 0;
+    OPENSSL_cleanse(actual, sizeof(actual));
+    return matches ? 1 : 0;
+}
