+static void
+pump_once(test_env_t *env, raw_client_t *clients[], size_t client_count)
+{
+    unsigned char packet[65536];
+    for (size_t i = 0; i < client_count; i++) {
+        if (clients[i] && clients[i]->engine) xqc_engine_main_logic(clients[i]->engine);
+    }
+
+    if (env->server) {
+        for (;;) {
+            struct sockaddr_storage peer;
+            socklen_t peer_len = sizeof(peer);
+            ssize_t count = recvfrom(env->server_fd, packet, sizeof(packet), MSG_DONTWAIT,
+                                     (struct sockaddr *)&peer, &peer_len);
+            if (count <= 0) break;
+            (void)mqvpn_server_on_socket_recv(env->server, packet, (size_t)count,
+                                              (struct sockaddr *)&peer, peer_len);
+        }
+        (void)mqvpn_server_tick(env->server);
+    }
+
+    for (size_t i = 0; i < client_count; i++) {
+        raw_client_t *client = clients[i];
+        if (!client || !client->engine) continue;
+        int received = 0;
+        for (;;) {
+            struct sockaddr_storage peer;
+            socklen_t peer_len = sizeof(peer);
+            ssize_t count = recvfrom(client->fd, packet, sizeof(packet), MSG_DONTWAIT,
+                                     (struct sockaddr *)&peer, &peer_len);
+            if (count <= 0) break;
+            received = 1;
+            (void)xqc_engine_packet_process(
+                client->engine, packet, (size_t)count,
+                (struct sockaddr *)&client->local_addr, sizeof(client->local_addr),
+                (struct sockaddr *)&peer, peer_len, test_now_us(), NULL);
+        }
+        if (received) xqc_engine_finish_recv(client->engine);
+        xqc_engine_main_logic(client->engine);
+    }
+
+    struct pollfd descriptors[MAX_TEST_CLIENTS + 1];
+    nfds_t descriptor_count = 0;
+    if (env->server) {
+        descriptors[descriptor_count++] =
+            (struct pollfd){.fd = env->server_fd, .events = POLLIN};
+    }
+    for (size_t i = 0; i < client_count; i++) {
+        if (clients[i] && clients[i]->engine) {
+            descriptors[descriptor_count++] =
+                (struct pollfd){.fd = clients[i]->fd, .events = POLLIN};
+        }
+    }
+    if (descriptor_count > 0) (void)poll(descriptors, descriptor_count, 1);
+}
+
+static int
+pump_until_int(test_env_t *env, raw_client_t *clients[], size_t client_count,
+               const int *value, int expected)
+{
+    for (int i = 0; i < PUMP_LIMIT; i++) {
+        if (*value == expected) return 0;
+        pump_once(env, clients, client_count);
+    }
+    return *value == expected ? 0 : -1;
+}
