diff --git a/tests/xqc_volparossa_edt_contract.c b/tests/xqc_volparossa_edt_contract.c
new file mode 100644
index 0000000..872a1a9
--- /dev/null
+++ b/tests/xqc_volparossa_edt_contract.c
@@ -0,0 +1,254 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+/**
+ * @copyright Copyright (c) 2026 VOLPAROSSA contributors
+ *
+ * One deterministic contract test for the exact scheduler callback used by
+ * production mqvpn sessions.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "xquic/xquic.h"
+#include "src/transport/xqc_conn.h"
+#include "src/transport/xqc_frame.h"
+#include "src/transport/xqc_multipath.h"
+#include "src/transport/xqc_packet_out.h"
+#include "src/transport/xqc_send_ctl.h"
+
+typedef struct edt_mock_congestion_s {
+    uint64_t cwnd_bytes;
+    uint32_t rate_bytes_per_second;
+} edt_mock_congestion_t;
+
+typedef struct edt_test_fixture_s {
+    xqc_connection_t conn;
+    xqc_log_t log;
+    xqc_path_ctx_t paths[3];
+    xqc_send_ctl_t send_ctls[3];
+    edt_mock_congestion_t congestion[3];
+    void *scheduler;
+} edt_test_fixture_t;
+
+static uint64_t
+edt_mock_get_cwnd(void *congestion)
+{
+    return ((edt_mock_congestion_t *)congestion)->cwnd_bytes;
+}
+
+static uint32_t
+edt_mock_get_bandwidth(void *congestion)
+{
+    return ((edt_mock_congestion_t *)congestion)->rate_bytes_per_second;
+}
+
+static const xqc_cong_ctrl_callback_t EDT_MOCK_CC = {
+    .xqc_cong_ctl_get_cwnd = edt_mock_get_cwnd,
+    .xqc_cong_ctl_get_bandwidth_estimate = edt_mock_get_bandwidth,
+};
+
+static void
+edt_add_path(edt_test_fixture_t *fixture, size_t index, uint64_t path_id,
+             uint64_t srtt_us, uint32_t rate_bytes_per_second,
+             uint64_t cwnd_bytes, uint32_t inflight_bytes,
+             unsigned recent_lost, unsigned recent_sent)
+{
+    xqc_path_ctx_t *path = &fixture->paths[index];
+    xqc_send_ctl_t *send_ctl = &fixture->send_ctls[index];
+    edt_mock_congestion_t *congestion = &fixture->congestion[index];
+
+    path->path_id = path_id;
+    path->path_state = XQC_PATH_STATE_ACTIVE;
+    path->app_path_status = XQC_APP_PATH_STATUS_AVAILABLE;
+    path->path_send_ctl = send_ctl;
+
+    congestion->cwnd_bytes = cwnd_bytes;
+    congestion->rate_bytes_per_second = rate_bytes_per_second;
+    send_ctl->ctl_conn = &fixture->conn;
+    send_ctl->ctl_path = path;
+    send_ctl->ctl_srtt = srtt_us;
+    send_ctl->ctl_bytes_in_flight = inflight_bytes;
+    send_ctl->ctl_cong = congestion;
+    send_ctl->ctl_cong_callback = &EDT_MOCK_CC;
+    send_ctl->ctl_recent_lost_count[0] = recent_lost;
+    send_ctl->ctl_recent_send_count[0] = recent_sent;
+    xqc_list_add_tail(&path->path_list, &fixture->conn.conn_paths_list);
+}
+
+static uint64_t
+edt_select(edt_test_fixture_t *fixture, xqc_bool_t *cc_blocked)
+{
+    xqc_packet_out_t packet;
+    memset(&packet, 0, sizeof(packet));
+    packet.po_frame_types = XQC_FRAME_BIT_DATAGRAM;
+    packet.po_used_size = 1200;
+    xqc_bool_t blocked = XQC_FALSE;
+    xqc_path_ctx_t *selected =
+        xqc_volparossa_edt_scheduler_cb.xqc_scheduler_get_path(
+            fixture->scheduler, &fixture->conn, &packet, 1, 0, &blocked);
+    if (cc_blocked != NULL) {
+        *cc_blocked = blocked;
+    }
+    return selected != NULL ? selected->path_id : UINT64_MAX;
+}
+
+int
+main(void)
+{
+    edt_test_fixture_t fixture;
+    memset(&fixture, 0, sizeof(fixture));
+    fixture.log.log_level = XQC_LOG_FATAL;
+    fixture.conn.log = &fixture.log;
+    xqc_init_list_head(&fixture.conn.conn_paths_list);
+    fixture.scheduler =
+        calloc(1, xqc_volparossa_edt_scheduler_cb.xqc_scheduler_size());
+    if (fixture.scheduler == NULL) {
+        fputs("could not allocate EDT scheduler fixture\n", stderr);
+        return 1;
+    }
+    xqc_volparossa_edt_scheduler_cb.xqc_scheduler_init(
+        fixture.scheduler, &fixture.log, NULL);
+
+    /* Two healthy paths: the low-RTT path initially arrives first. */
+    edt_add_path(&fixture, 0, 10, 12000, 20000000, 128000, 2000, 0, 100);
+    edt_add_path(&fixture, 1, 20, 18000, 40000000, 128000, 1000, 0, 100);
+    /* This path looks fast by RTT/rate alone but is queued, congested and
+     * lossy, so its predicted delivery is later than either healthy path. */
+    edt_add_path(&fixture, 2, 30, 5000, 100000000, 128000, 100000, 80, 100);
+    for (size_t index = 0; index < 3; ++index) {
+        fixture.send_ctls[index].ctl_delivered = 2ULL * 1024ULL * 1024ULL;
+        fixture.send_ctls[index].ctl_bytes_send =
+            fixture.send_ctls[index].ctl_delivered;
+    }
+
+    if (edt_select(&fixture, NULL) != 10) {
+        fputs("EDT did not select the earliest healthy path\n", stderr);
+        return 1;
+    }
+
+    /* A full cwnd removes path 10 immediately; live metrics then select the
+     * other healthy path, never the superficially-fast lossy path 30. */
+    fixture.send_ctls[0].ctl_bytes_in_flight = 128000;
+    if (edt_select(&fixture, NULL) != 20) {
+        fputs("EDT did not move to the other healthy path\n", stderr);
+        return 1;
+    }
+
+    /* Missing RTT and delivery-rate samples are normal before the first ACK.
+     * Pick the lowest-ID sendable path so the QUIC Initial can leave. */
+    fixture.paths[0].path_id = 30;
+    fixture.paths[1].path_id = 10;
+    fixture.paths[2].path_id = 20;
+    for (size_t index = 0; index < 3; ++index) {
+        fixture.send_ctls[index].ctl_srtt = 0;
+        fixture.send_ctls[index].ctl_bytes_in_flight = 0;
+        fixture.congestion[index].rate_bytes_per_second = 0;
+    }
+    xqc_bool_t cc_blocked = XQC_TRUE;
+    if (edt_select(&fixture, &cc_blocked) != 10 || cc_blocked) {
+        fputs("EDT did not send deterministically at cold start\n", stderr);
+        return 1;
+    }
+
+    /* A finite path may not starve a cold path.  The cold path receives real
+     * application traffic until every active path has 2 MiB acknowledged. */
+    fixture.send_ctls[0].ctl_srtt = 12000;
+    fixture.congestion[0].rate_bytes_per_second = 20000000;
+    fixture.paths[2].app_path_status = XQC_APP_PATH_STATUS_STANDBY;
+    fixture.send_ctls[1].ctl_delivered = 0;
+    fixture.send_ctls[1].ctl_bytes_send = 0;
+    if (edt_select(&fixture, NULL) != 10) {
+        fputs("EDT did not explore the cold active path\n", stderr);
+        return 1;
+    }
+
+    /* Bytes already assigned in this send burst count toward exploration,
+     * so a large burst cannot be queued entirely on the first path before
+     * its send counters advance. */
+    fixture.paths[1].path_schedule_bytes = 256 * 1024;
+    if (edt_select(&fixture, NULL) != 30) {
+        fputs("EDT did not balance projected startup delivery\n", stderr);
+        return 1;
+    }
+    fixture.paths[1].path_schedule_bytes = 0;
+
+    /* ACKed transport bytes, rather than attempted sends, end exploration.
+     * Once both paths reach the floor, the finite EDT estimate wins. */
+    fixture.send_ctls[0].ctl_delivered = 2ULL * 1024ULL * 1024ULL;
+    fixture.send_ctls[1].ctl_delivered = 2ULL * 1024ULL * 1024ULL;
+    fixture.send_ctls[0].ctl_bytes_send = fixture.send_ctls[0].ctl_delivered;
+    fixture.send_ctls[1].ctl_bytes_send = fixture.send_ctls[1].ctl_delivered;
+    if (edt_select(&fixture, NULL) != 30) {
+        fputs("EDT did not resume metric selection after exploration\n", stderr);
+        return 1;
+    }
+
+    /* A later transfer on the same connection must still exercise both paths.
+     * Start at the maximum permitted service skew, make path 30's EDT vastly
+     * better, then schedule the exact 4 MiB A07 pre-failure request.  Bounding
+     * both the start and end skew to 256 KiB plus one 1200-byte packet gives
+     * each path more than 1.74 MiB of new genuine traffic. */
+    const uint64_t baseline = 8ULL * 1024ULL * 1024ULL;
+    const uint64_t service_skew = 256ULL * 1024ULL;
+    fixture.send_ctls[0].ctl_delivered = baseline + service_skew;
+    fixture.send_ctls[0].ctl_bytes_send = fixture.send_ctls[0].ctl_delivered;
+    fixture.send_ctls[0].ctl_srtt = 1000;
+    fixture.congestion[0].rate_bytes_per_second = 1000000000U;
+    fixture.congestion[0].cwnd_bytes = 16ULL * 1024ULL * 1024ULL;
+    fixture.send_ctls[1].ctl_delivered = baseline;
+    fixture.send_ctls[1].ctl_bytes_send = fixture.send_ctls[1].ctl_delivered;
+    fixture.send_ctls[1].ctl_srtt = 100000;
+    fixture.congestion[1].rate_bytes_per_second = 1000000U;
+    fixture.congestion[1].cwnd_bytes = 16ULL * 1024ULL * 1024ULL;
+    uint64_t assigned_path_30 = 0;
+    uint64_t assigned_path_10 = 0;
+    const uint64_t later_transfer_bytes = 4ULL * 1024ULL * 1024ULL;
+    while (assigned_path_30 + assigned_path_10 < later_transfer_bytes) {
+        uint64_t selected = edt_select(&fixture, NULL);
+        if (selected == 30) {
+            assigned_path_30 += 1200;
+            fixture.paths[0].path_schedule_bytes += 1200;
+        } else if (selected == 10) {
+            assigned_path_10 += 1200;
+            fixture.paths[1].path_schedule_bytes += 1200;
+        } else {
+            fputs("EDT selected an unexpected path in later transfer\n", stderr);
+            return 1;
+        }
+    }
+    if (assigned_path_30 <= 1024ULL * 1024ULL
+        || assigned_path_10 <= 1024ULL * 1024ULL)
+    {
+        fputs("EDT starved one path in a later same-session transfer\n", stderr);
+        return 1;
+    }
+
+    /* An active black hole gets a bounded opportunity to obtain ACKs.  ACKed
+     * progress reduces its attempt debt; after 8 MiB remains unacknowledged,
+     * it cannot indefinitely override EDT. */
+    fixture.paths[0].path_schedule_bytes = 0;
+    fixture.paths[1].path_schedule_bytes = 0;
+    fixture.send_ctls[0].ctl_delivered = baseline + 2ULL * 1024ULL * 1024ULL;
+    fixture.send_ctls[0].ctl_bytes_send = fixture.send_ctls[0].ctl_delivered;
+    fixture.send_ctls[1].ctl_delivered = baseline;
+    fixture.send_ctls[1].ctl_bytes_send = baseline;
+    (void)edt_select(&fixture, NULL);
+    fixture.send_ctls[1].ctl_delivered = baseline + 1024ULL * 1024ULL;
+    fixture.send_ctls[1].ctl_bytes_send =
+        baseline + 8ULL * 1024ULL * 1024ULL;
+    if (edt_select(&fixture, NULL) != 10) {
+        fputs("EDT did not subtract ACK progress from attempt debt\n", stderr);
+        return 1;
+    }
+    fixture.send_ctls[1].ctl_bytes_send =
+        baseline + 9ULL * 1024ULL * 1024ULL;
+    if (edt_select(&fixture, NULL) != 30) {
+        fputs("EDT did not bound unsuccessful path exploration\n", stderr);
+        return 1;
+    }
+    free(fixture.scheduler);
+    return 0;
+}
