@@ -0,0 +1,519 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+/**
+ * @copyright Copyright (c) 2026 VOLPAROSSA contributors
+ *
+ * One deterministic contract test for the exact scheduler callback used by
+ * production mqvpn sessions.
+ */
+
+#define _GNU_SOURCE
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "xquic/xquic.h"
+#include "src/transport/xqc_conn.h"
+#include "src/transport/xqc_frame.h"
+#include "src/transport/xqc_multipath.h"
+#include "src/transport/xqc_packet_out.h"
+#include "src/transport/xqc_send_ctl.h"
+
+typedef struct edt_mock_congestion_s {
+    uint64_t cwnd_bytes;
+    uint32_t rate_bytes_per_second;
+} edt_mock_congestion_t;
+
+typedef struct edt_test_fixture_s {
+    xqc_connection_t conn;
+    xqc_log_t log;
+    xqc_path_ctx_t paths[3];
+    xqc_send_ctl_t send_ctls[3];
+    edt_mock_congestion_t congestion[3];
+    void *scheduler;
+} edt_test_fixture_t;
+
+static uint64_t
+edt_mock_get_cwnd(void *congestion)
+{
+    return ((edt_mock_congestion_t *)congestion)->cwnd_bytes;
+}
+
+static uint32_t
+edt_mock_get_bandwidth(void *congestion)
+{
+    return ((edt_mock_congestion_t *)congestion)->rate_bytes_per_second;
+}
+
+static const xqc_cong_ctrl_callback_t EDT_MOCK_CC = {
+    .xqc_cong_ctl_get_cwnd = edt_mock_get_cwnd,
+    .xqc_cong_ctl_get_bandwidth_estimate = edt_mock_get_bandwidth,
+};
+
+static void
+edt_add_path(edt_test_fixture_t *fixture, size_t index, uint64_t path_id,
+             uint64_t srtt_us, uint32_t rate_bytes_per_second,
+             uint64_t cwnd_bytes, uint32_t inflight_bytes,
+             unsigned recent_lost, unsigned recent_sent)
+{
+    xqc_path_ctx_t *path = &fixture->paths[index];
+    xqc_send_ctl_t *send_ctl = &fixture->send_ctls[index];
+    edt_mock_congestion_t *congestion = &fixture->congestion[index];
+
+    path->path_id = path_id;
+    path->path_state = XQC_PATH_STATE_ACTIVE;
+    path->app_path_status = XQC_APP_PATH_STATUS_AVAILABLE;
+    path->path_send_ctl = send_ctl;
+
+    congestion->cwnd_bytes = cwnd_bytes;
+    congestion->rate_bytes_per_second = rate_bytes_per_second;
+    send_ctl->ctl_conn = &fixture->conn;
+    send_ctl->ctl_path = path;
+    send_ctl->ctl_srtt = srtt_us;
+    send_ctl->ctl_bytes_in_flight = inflight_bytes;
+    send_ctl->ctl_cong = congestion;
+    send_ctl->ctl_cong_callback = &EDT_MOCK_CC;
+    send_ctl->ctl_recent_lost_count[0] = recent_lost;
+    send_ctl->ctl_recent_send_count[0] = recent_sent;
+    xqc_list_add_tail(&path->path_list, &fixture->conn.conn_paths_list);
+}
+
+static uint64_t
+edt_select(edt_test_fixture_t *fixture, xqc_bool_t *cc_blocked)
+{
+    xqc_packet_out_t packet;
+    memset(&packet, 0, sizeof(packet));
+    packet.po_frame_types = XQC_FRAME_BIT_DATAGRAM;
+    packet.po_used_size = 1200;
+    xqc_bool_t blocked = XQC_FALSE;
+    xqc_path_ctx_t *selected =
+        xqc_volparossa_edt_scheduler_cb.xqc_scheduler_get_path(
+            fixture->scheduler, &fixture->conn, &packet, 1, 0, &blocked);
+    if (cc_blocked != NULL) {
+        *cc_blocked = blocked;
+    }
+    return selected != NULL ? selected->path_id : UINT64_MAX;
+}
+
+static int
+edt_blackhole_small_retransmission_budget(void)
+{
+    edt_test_fixture_t fixture;
+    memset(&fixture, 0, sizeof(fixture));
+    fixture.log.log_level = XQC_LOG_FATAL;
+    fixture.conn.log = &fixture.log;
+    xqc_init_list_head(&fixture.conn.conn_paths_list);
+    fixture.scheduler =
+        calloc(1, xqc_volparossa_edt_scheduler_cb.xqc_scheduler_size());
+    if (fixture.scheduler == NULL) return 1;
+    xqc_volparossa_edt_scheduler_cb.xqc_scheduler_init(
+        fixture.scheduler, &fixture.log, NULL);
+
+    /* Same-session history after a completed transfer. R1 is now a silent
+     * black hole, but has not yet hit the 120-second path idle timeout.
+     * R2 still ACKs control traffic; both paths have ample cwnd headroom. */
+    edt_add_path(&fixture, 0, 10, 100000, 1000000, 1048576, 0, 80, 100);
+    edt_add_path(&fixture, 1, 20, 1000, 20000000, 1048576, 0, 0, 100);
+    fixture.send_ctls[0].ctl_delivered = 8ULL * 1024ULL * 1024ULL;
+    fixture.send_ctls[1].ctl_delivered =
+        fixture.send_ctls[0].ctl_delivered + 512ULL * 1024ULL;
+    for (size_t i = 0; i < 2; ++i) {
+        fixture.send_ctls[i].ctl_bytes_send = fixture.send_ctls[i].ctl_delivered;
+    }
+
+    /* A non-application packet uses the exact same live cost and cwnd checks,
+     * without forced application service: prove R2 really is the EDT winner. */
+    xqc_packet_out_t control_packet;
+    memset(&control_packet, 0, sizeof(control_packet));
+    control_packet.po_frame_types = XQC_FRAME_BIT_PING;
+    control_packet.po_used_size = 1200;
+    xqc_bool_t blocked = XQC_FALSE;
+    xqc_path_ctx_t *winner =
+        xqc_volparossa_edt_scheduler_cb.xqc_scheduler_get_path(
+            fixture.scheduler, &fixture.conn, &control_packet, 1, 0, &blocked);
+    if (winner != &fixture.paths[1] || blocked) {
+        fputs("healthy R2 was not the finite EDT winner\n", stderr);
+        free(fixture.scheduler);
+        return 1;
+    }
+
+    unsigned blackhole_packets = 0;
+    for (unsigned i = 0; i < 32; ++i) {
+        uint64_t selected = edt_select(&fixture, NULL);
+        if (selected == 10) {
+            blackhole_packets++;
+            fixture.send_ctls[0].ctl_bytes_send += 1200;
+            fixture.send_ctls[0].ctl_bytes_in_flight += 1200;
+        } else if (selected == 20) {
+            fixture.send_ctls[1].ctl_delivered += 1200;
+            fixture.send_ctls[1].ctl_bytes_send += 1200;
+        } else {
+            free(fixture.scheduler);
+            return 1;
+        }
+        fixture.send_ctls[1].ctl_delivered += 64;
+        fixture.send_ctls[1].ctl_bytes_send += 64;
+    }
+    free(fixture.scheduler);
+    if (blackhole_packets != 0) {
+        fprintf(stderr, "forced service sent %u/32 application packets to "
+                "the black hole despite healthy EDT winner R2\n", blackhole_packets);
+        return 1;
+    }
+    return 0;
+}
+
+static xqc_usec_t edt_ack_age_test_now;
+
+static xqc_usec_t
+edt_ack_age_test_clock(void)
+{
+    return edt_ack_age_test_now;
+}
+
+static int
+edt_warm_stale_fast_path_ack_age(void)
+{
+    edt_test_fixture_t fixture;
+    memset(&fixture, 0, sizeof(fixture));
+    fixture.log.log_level = XQC_LOG_FATAL;
+    fixture.conn.log = &fixture.log;
+    fixture.conn.remote_settings.max_ack_delay = 25;
+    xqc_init_list_head(&fixture.conn.conn_paths_list);
+    fixture.scheduler =
+        calloc(1, xqc_volparossa_edt_scheduler_cb.xqc_scheduler_size());
+    if (fixture.scheduler == NULL) return 1;
+    xqc_volparossa_edt_scheduler_cb.xqc_scheduler_init(
+        fixture.scheduler, &fixture.log, NULL);
+
+    /* Actual mixed-link 34139658819 states after warm-up: the disappeared
+     * LAN retains its old low RTT and large cwnd. No subsequent ACK means
+     * no packet-threshold loss declaration; tiny 2/s inner ACKs never fill
+     * its cwnd. The WAN remains writable with a much larger measured RTT. */
+    edt_add_path(&fixture, 0, 1, 1762, 1520439, 239809, 1298, 0, 100);
+    edt_add_path(&fixture, 1, 2, 270034, 1947368, 338696, 0, 0, 100);
+    fixture.send_ctls[0].ctl_delivered = 5766117;
+    fixture.send_ctls[0].ctl_bytes_send = 5924171;
+    fixture.send_ctls[1].ctl_delivered = 3722034;
+    fixture.send_ctls[1].ctl_bytes_send = 3976972;
+    fixture.send_ctls[0].ctl_rttvar = 400;
+
+    xqc_timestamp_pt saved_clock = xqc_monotonic_timestamp;
+    xqc_monotonic_timestamp = edt_ack_age_test_clock;
+    edt_ack_age_test_now = 100000000;
+    fixture.send_ctls[0].ctl_delivered_time = edt_ack_age_test_now;
+    int failed = 0;
+    if (edt_select(&fixture, NULL) != 1) {
+        fputs("fresh low-RTT path lost before its ACK allowance\n", stderr);
+        failed = 1;
+        goto done;
+    }
+    /* Observed tiny sends keep the old path below cwnd for the whole
+     * stalled interval. Advancing send time must not refresh ACK progress. */
+    for (unsigned i = 0; i < 32; ++i) {
+        edt_ack_age_test_now += 500000;
+        fixture.send_ctls[0].ctl_bytes_send += 93;
+        fixture.send_ctls[0].ctl_bytes_in_flight += 76;
+        fixture.send_ctls[0].ctl_last_inflight_pkt_sent_time =
+            edt_ack_age_test_now;
+        fixture.send_ctls[1].ctl_delivered += 14;
+        fixture.send_ctls[1].ctl_delivered_time = edt_ack_age_test_now;
+        if (edt_select(&fixture, NULL) != 2) {
+            fputs("stale fast LAN still wins despite live writable WAN\n", stderr);
+            failed = 1;
+            goto done;
+        }
+    }
+    /* Real ACK progress restores eligibility without timers/path mutation. */
+    fixture.send_ctls[0].ctl_delivered += 1200;
+    fixture.send_ctls[0].ctl_delivered_time = edt_ack_age_test_now;
+    if (edt_select(&fixture, NULL) != 1) {
+        fputs("ACK recovery did not restore live fast-path EDT\n", stderr);
+        failed = 1;
+        goto done;
+    }
+    /* Idle time alone is not evidence of failed delivery. */
+    edt_ack_age_test_now += 10000000;
+    fixture.send_ctls[0].ctl_bytes_in_flight = 0;
+    if (edt_select(&fixture, NULL) != 1) {
+        fputs("idle healthy path was treated as stalled delivery\n", stderr);
+        failed = 1;
+        goto done;
+    }
+    /* The only remaining usable path is never suppressed by stale cost. */
+    fixture.send_ctls[0].ctl_bytes_in_flight = 1298;
+    fixture.paths[1].app_path_status = XQC_APP_PATH_STATUS_STANDBY;
+    if (edt_select(&fixture, NULL) != 1) {
+        fputs("stale estimate suppressed the only writable path\n", stderr);
+        failed = 1;
+    }
+done:
+    xqc_monotonic_timestamp = saved_clock;
+    free(fixture.scheduler);
+    return failed;
+}
+
+static int
+edt_bounded_fixture_trace(const char *option)
+{
+    edt_test_fixture_t fixture;
+    memset(&fixture, 0, sizeof(fixture));
+    fixture.log.log_level = XQC_LOG_FATAL;
+    fixture.conn.log = &fixture.log;
+    xqc_init_list_head(&fixture.conn.conn_paths_list);
+    fixture.scheduler =
+        calloc(1, xqc_volparossa_edt_scheduler_cb.xqc_scheduler_size());
+    if (fixture.scheduler == NULL) return 1;
+    int failed = 1;
+    int capture = -1;
+    int saved_stderr = -1;
+    xqc_timestamp_pt saved_clock = xqc_monotonic_timestamp;
+    if (option == NULL ? unsetenv("VMP_DEV_EDT_TRACE") != 0
+                       : setenv("VMP_DEV_EDT_TRACE", option, 1) != 0)
+    {
+        goto done;
+    }
+    xqc_volparossa_edt_scheduler_cb.xqc_scheduler_init(
+        fixture.scheduler, &fixture.log, NULL);
+    /* The option is sampled once at initialization, never per packet. */
+    if (unsetenv("VMP_DEV_EDT_TRACE") != 0) goto done;
+    edt_add_path(&fixture, 0, 10, 12000, 20000000, 128000, 2000, 0, 100);
+    edt_add_path(&fixture, 1, 20, 18000, 40000000, 128000, 1000, 0, 100);
+    edt_add_path(&fixture, 2, 30, 1000, 40000000, 500, 0, 0, 100);
+    capture = memfd_create("edt-fixture-trace", MFD_CLOEXEC);
+    saved_stderr = dup(STDERR_FILENO);
+    if (capture < 0 || saved_stderr < 0) goto done;
+    if (fflush(stderr) != 0 || dup2(capture, STDERR_FILENO) < 0) goto done;
+    xqc_monotonic_timestamp = edt_ack_age_test_clock;
+    edt_ack_age_test_now = 100000000;
+    /* Startup exploration and control-only scheduling do not start the
+     * diagnostic clock. All calls still choose their ordinary real winner. */
+    if (edt_select(&fixture, NULL) != 20) goto done;
+    for (size_t i = 0; i < 3; ++i) {
+        fixture.send_ctls[i].ctl_delivered = 2ULL * 1024ULL * 1024ULL;
+        fixture.send_ctls[i].ctl_bytes_send = fixture.send_ctls[i].ctl_delivered;
+    }
+    edt_ack_age_test_now = 105000000;
+    xqc_packet_out_t control;
+    memset(&control, 0, sizeof(control));
+    control.po_frame_types = XQC_FRAME_BIT_PING;
+    control.po_used_size = 1200;
+    if (xqc_volparossa_edt_scheduler_cb.xqc_scheduler_get_path(
+        fixture.scheduler, &fixture.conn, &control, 1, 0, NULL)
+        != &fixture.paths[0]) goto done;
+    const xqc_usec_t start = 106000000;
+    edt_ack_age_test_now = start;
+    if (edt_select(&fixture, NULL) != 10) goto done;
+    edt_ack_age_test_now = start + 9999999;
+    if (edt_select(&fixture, NULL) != 10) goto done;
+    for (unsigned i = 0; i < 68; ++i) {
+        edt_ack_age_test_now = start + 10000000 + (uint64_t)i * 156250;
+        if (edt_select(&fixture, NULL) != 10) goto done;
+        edt_ack_age_test_now++;
+        if (edt_select(&fixture, NULL) != 10) goto done;
+    }
+    if (fflush(stderr) != 0 || lseek(capture, 0, SEEK_SET) < 0) goto done;
+    char output[65536];
+    ssize_t length = read(capture, output, sizeof(output) - 1);
+    if (length < 0 || (size_t)length == sizeof(output) - 1) goto done;
+    output[length] = '\0';
+    if (option == NULL || strcmp(option, "1") != 0) {
+        failed = length != 0;
+        goto done;
+    }
+    unsigned count = 0;
+    char *save = NULL;
+    for (char *line = strtok_r(output, "\n", &save); line != NULL;
+         line = strtok_r(NULL, "\n", &save))
+    {
+        unsigned sample = 0;
+        uint64_t elapsed = 0;
+        if (sscanf(line, "NATIVE_EDT_SAMPLE {\"sample\":%u,"
+                   "\"elapsed_us\":%" SCNu64, &sample, &elapsed) != 2
+            || sample != count + 1
+            || elapsed != 10000000 + (uint64_t)count * 156250
+            || strstr(line, "\"selected_path\":10,\"has_selected\":1,"
+                      "\"startup\":0,\"eligible_count\":3,") == NULL
+            || strstr(line, "\"path\":10,\"sendable\":1,\"cost_us\":6348,") == NULL
+            || strstr(line, "\"path\":20,\"sendable\":1,\"cost_us\":9196,") == NULL
+            || strstr(line, "\"path\":30,\"sendable\":0,"
+                      "\"cost_us\":18446744073709551615,") == NULL)
+        {
+            goto done;
+        }
+        count++;
+    }
+    failed = count != 64;
+done:
+    (void)fflush(stderr);
+    if (saved_stderr >= 0) {
+        if (dup2(saved_stderr, STDERR_FILENO) < 0) failed = 1;
+        close(saved_stderr);
+    }
+    if (capture >= 0) close(capture);
+    xqc_monotonic_timestamp = saved_clock;
+    free(fixture.scheduler);
+    if (failed) fputs("bounded EDT fixture diagnostic contract failed\n", stderr);
+    return failed;
+}
+
+int
+main(void)
+{
+    edt_test_fixture_t fixture;
+    memset(&fixture, 0, sizeof(fixture));
+    fixture.log.log_level = XQC_LOG_FATAL;
+    fixture.conn.log = &fixture.log;
+    xqc_init_list_head(&fixture.conn.conn_paths_list);
+    fixture.scheduler =
+        calloc(1, xqc_volparossa_edt_scheduler_cb.xqc_scheduler_size());
+    if (fixture.scheduler == NULL) {
+        fputs("could not allocate EDT scheduler fixture\n", stderr);
+        return 1;
+    }
+    xqc_volparossa_edt_scheduler_cb.xqc_scheduler_init(
+        fixture.scheduler, &fixture.log, NULL);
+
+    /* Two healthy paths: the low-RTT path initially arrives first. */
+    edt_add_path(&fixture, 0, 10, 12000, 20000000, 128000, 2000, 0, 100);
+    edt_add_path(&fixture, 1, 20, 18000, 40000000, 128000, 1000, 0, 100);
+    /* This path looks fast by RTT/rate alone but is queued, congested and
+     * lossy, so its predicted delivery is later than either healthy path. */
+    edt_add_path(&fixture, 2, 30, 5000, 100000000, 128000, 100000, 80, 100);
+    for (size_t index = 0; index < 3; ++index) {
+        fixture.send_ctls[index].ctl_delivered = 2ULL * 1024ULL * 1024ULL;
+        fixture.send_ctls[index].ctl_bytes_send =
+            fixture.send_ctls[index].ctl_delivered;
+    }
+
+    if (edt_select(&fixture, NULL) != 10) {
+        fputs("EDT did not select the earliest healthy path\n", stderr);
+        return 1;
+    }
+
+    /* A full cwnd removes path 10 immediately; live metrics then select the
+     * other healthy path, never the superficially-fast lossy path 30. */
+    fixture.send_ctls[0].ctl_bytes_in_flight = 128000;
+    if (edt_select(&fixture, NULL) != 20) {
+        fputs("EDT did not move to the other healthy path\n", stderr);
+        return 1;
+    }
+
+    /* Missing RTT and delivery-rate samples are normal before the first ACK.
+     * Pick the lowest-ID sendable path so the QUIC Initial can leave. */
+    fixture.paths[0].path_id = 30;
+    fixture.paths[1].path_id = 10;
+    fixture.paths[2].path_id = 20;
+    for (size_t index = 0; index < 3; ++index) {
+        fixture.send_ctls[index].ctl_srtt = 0;
+        fixture.send_ctls[index].ctl_bytes_in_flight = 0;
+        fixture.congestion[index].rate_bytes_per_second = 0;
+    }
+    xqc_bool_t cc_blocked = XQC_TRUE;
+    if (edt_select(&fixture, &cc_blocked) != 10 || cc_blocked) {
+        fputs("EDT did not send deterministically at cold start\n", stderr);
+        return 1;
+    }
+
+    /* A finite path may not starve a cold path.  The cold path receives real
+     * application traffic until every active path has 2 MiB acknowledged. */
+    fixture.send_ctls[0].ctl_srtt = 12000;
+    fixture.congestion[0].rate_bytes_per_second = 20000000;
+    fixture.paths[2].app_path_status = XQC_APP_PATH_STATUS_STANDBY;
+    fixture.send_ctls[1].ctl_delivered = 0;
+    fixture.send_ctls[1].ctl_bytes_send = 0;
+    if (edt_select(&fixture, NULL) != 10) {
+        fputs("EDT did not explore the cold active path\n", stderr);
+        return 1;
+    }
+
+    /* Bytes already assigned in this send burst count toward exploration,
+     * so a large burst cannot be queued entirely on the first path before
+     * its send counters advance. */
+    fixture.paths[1].path_schedule_bytes = 256 * 1024;
+    if (edt_select(&fixture, NULL) != 30) {
+        fputs("EDT did not balance projected startup delivery\n", stderr);
+        return 1;
+    }
+    fixture.paths[1].path_schedule_bytes = 0;
+
+    /* ACKed transport bytes, rather than attempted sends, end exploration.
+     * Once both paths reach the floor, the finite EDT estimate wins. */
+    fixture.send_ctls[0].ctl_delivered = 2ULL * 1024ULL * 1024ULL;
+    fixture.send_ctls[1].ctl_delivered = 2ULL * 1024ULL * 1024ULL;
+    fixture.send_ctls[0].ctl_bytes_send = fixture.send_ctls[0].ctl_delivered;
+    fixture.send_ctls[1].ctl_bytes_send = fixture.send_ctls[1].ctl_delivered;
+    if (edt_select(&fixture, NULL) != 30) {
+        fputs("EDT did not resume metric selection after exploration\n", stderr);
+        return 1;
+    }
+
+    /* After warm-up, historical delivery skew cannot override live EDT.
+     * Path 30 remains the earlier delivery even as this 4 MiB burst queues;
+     * a later same-session transfer must not force service onto slow path 10. */
+    const uint64_t baseline = 8ULL * 1024ULL * 1024ULL;
+    const uint64_t historical_skew = 512ULL * 1024ULL;
+    fixture.send_ctls[0].ctl_delivered = baseline + historical_skew;
+    fixture.send_ctls[0].ctl_bytes_send = fixture.send_ctls[0].ctl_delivered;
+    fixture.send_ctls[0].ctl_srtt = 1000;
+    fixture.congestion[0].rate_bytes_per_second = 1000000000U;
+    fixture.congestion[0].cwnd_bytes = 16ULL * 1024ULL * 1024ULL;
+    fixture.send_ctls[1].ctl_delivered = baseline;
+    fixture.send_ctls[1].ctl_bytes_send = fixture.send_ctls[1].ctl_delivered;
+    fixture.send_ctls[1].ctl_srtt = 100000;
+    fixture.congestion[1].rate_bytes_per_second = 1000000U;
+    fixture.congestion[1].cwnd_bytes = 16ULL * 1024ULL * 1024ULL;
+    uint64_t assigned_path_30 = 0;
+    uint64_t assigned_path_10 = 0;
+    const uint64_t later_transfer_bytes = 4ULL * 1024ULL * 1024ULL;
+    while (assigned_path_30 + assigned_path_10 < later_transfer_bytes) {
+        uint64_t selected = edt_select(&fixture, NULL);
+        if (selected == 30) {
+            assigned_path_30 += 1200;
+            fixture.paths[0].path_schedule_bytes += 1200;
+        } else if (selected == 10) {
+            assigned_path_10 += 1200;
+            fixture.paths[1].path_schedule_bytes += 1200;
+        } else {
+            fputs("EDT selected an unexpected path in later transfer\n", stderr);
+            return 1;
+        }
+    }
+    if (assigned_path_30 < later_transfer_bytes || assigned_path_10 != 0)
+    {
+        fputs("historical byte skew overrode post-warm-up EDT cost\n", stderr);
+        return 1;
+    }
+
+    /* A cold active path gets a bounded opportunity to obtain ACKs.  ACKed
+     * progress reduces its attempt debt; after 8 MiB remains unacknowledged,
+     * it cannot indefinitely override EDT. */
+    fixture.paths[0].path_schedule_bytes = 0;
+    fixture.paths[1].path_schedule_bytes = 0;
+    fixture.send_ctls[0].ctl_delivered = baseline + 2ULL * 1024ULL * 1024ULL;
+    fixture.send_ctls[0].ctl_bytes_send = fixture.send_ctls[0].ctl_delivered;
+    fixture.send_ctls[1].ctl_delivered = 0;
+    fixture.send_ctls[1].ctl_bytes_send = 0;
+    (void)edt_select(&fixture, NULL);
+    fixture.send_ctls[1].ctl_delivered = 1024ULL * 1024ULL;
+    fixture.send_ctls[1].ctl_bytes_send = 8ULL * 1024ULL * 1024ULL;
+    if (edt_select(&fixture, NULL) != 10) {
+        fputs("EDT did not subtract ACK progress from attempt debt\n", stderr);
+        return 1;
+    }
+    fixture.send_ctls[1].ctl_bytes_send = 9ULL * 1024ULL * 1024ULL;
+    if (edt_select(&fixture, NULL) != 30) {
+        fputs("EDT did not bound unsuccessful path exploration\n", stderr);
+        return 1;
+    }
+    free(fixture.scheduler);
+    if (edt_blackhole_small_retransmission_budget() != 0) return 1;
+    if (edt_warm_stale_fast_path_ack_age() != 0) return 1;
+    if (edt_bounded_fixture_trace(NULL) != 0) return 1;
+    if (edt_bounded_fixture_trace("true") != 0) return 1;
+    return edt_bounded_fixture_trace("1");
+}
