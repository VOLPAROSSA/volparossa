diff --git a/src/transport/scheduler/xqc_scheduler_volparossa_edt.c b/src/transport/scheduler/xqc_scheduler_volparossa_edt.c
new file mode 100644
index 0000000..9288f50
--- /dev/null
+++ b/src/transport/scheduler/xqc_scheduler_volparossa_edt.c
@@ -0,0 +1,201 @@
+// SPDX-License-Identifier: GPL-3.0-only
+
+/**
+ * @copyright Copyright (c) 2026 VOLPAROSSA contributors
+ *
+ * Select exactly one currently writable path by estimated delivery time:
+ *
+ *   RTT/2 + queued/rate + RTT*(inflight/cwnd)
+ *         + RTT*(loss/(1-loss))
+ *
+ * queued is the path's current bytes in flight plus the packet being
+ * scheduled.  The independent congestion term makes a nearly-full cwnd lose
+ * before it becomes completely blocked.  The loss multiplier is capped at
+ * 100 RTTs and the queue term at 60 seconds, keeping adversarial or transient
+ * counters finite.  Reinjection is deliberately unsupported: this scheduler
+ * returns one original path and never duplicates or applies FEC.
+ */
+
+#include "src/transport/scheduler/xqc_scheduler_volparossa_edt.h"
+
+#include "src/transport/scheduler/xqc_scheduler_common.h"
+#include "src/transport/xqc_multipath.h"
+#include "src/transport/xqc_send_ctl.h"
+
+#include <limits.h>
+
+#define VOLPAROSSA_EDT_QUEUE_LIMIT_US (60ULL * 1000000ULL)
+#define VOLPAROSSA_EDT_LOSS_MULTIPLIER_LIMIT 100.0L
+
+static uint64_t
+volparossa_edt_saturating_add(uint64_t left, uint64_t right)
+{
+    return UINT64_MAX - left < right ? UINT64_MAX : left + right;
+}
+
+static uint64_t
+volparossa_edt_bounded_us(long double value, uint64_t limit)
+{
+    if (value <= 0.0L) {
+        return 0;
+    }
+    if (value >= (long double)limit) {
+        return limit;
+    }
+    return (uint64_t)(value + 0.999999L);
+}
+
+static uint64_t
+volparossa_edt_cost_us(xqc_path_ctx_t *path, size_t packet_bytes)
+{
+    xqc_send_ctl_t *ctl = path->path_send_ctl;
+    if (ctl == NULL || ctl->ctl_cong_callback == NULL
+        || ctl->ctl_cong_callback->xqc_cong_ctl_get_cwnd == NULL)
+    {
+        return UINT64_MAX;
+    }
+
+    uint64_t srtt_us = xqc_send_ctl_get_srtt(ctl);
+    uint64_t cwnd_bytes =
+        ctl->ctl_cong_callback->xqc_cong_ctl_get_cwnd(ctl->ctl_cong);
+    uint64_t inflight_bytes = ctl->ctl_bytes_in_flight;
+    uint64_t packet = packet_bytes > 0 ? (uint64_t)packet_bytes : 1;
+    if (srtt_us == 0 || cwnd_bytes == 0 || packet > UINT64_MAX - inflight_bytes
+        || inflight_bytes + packet > cwnd_bytes)
+    {
+        return UINT64_MAX;
+    }
+
+    uint64_t rate_bytes_per_second = xqc_send_ctl_get_est_bw(ctl);
+    if (rate_bytes_per_second == 0) {
+        return UINT64_MAX;
+    }
+
+    uint64_t queued_bytes = inflight_bytes + packet;
+    long double queue_us =
+        ((long double)queued_bytes * 1000000.0L)
+        / (long double)rate_bytes_per_second;
+    uint64_t queue_cost = volparossa_edt_bounded_us(
+        queue_us, VOLPAROSSA_EDT_QUEUE_LIMIT_US);
+
+    long double congestion_us =
+        ((long double)srtt_us * (long double)inflight_bytes)
+        / (long double)cwnd_bytes;
+    uint64_t congestion_cost = volparossa_edt_bounded_us(
+        congestion_us, VOLPAROSSA_EDT_QUEUE_LIMIT_US);
+
+    long double loss = (long double)xqc_path_recent_loss_rate(path) / 100.0L;
+    if (loss < 0.0L) {
+        loss = 0.0L;
+    } else if (loss > 1.0L) {
+        loss = 1.0L;
+    }
+    long double loss_denominator = 1.0L - loss;
+    if (loss_denominator < 0.01L) {
+        loss_denominator = 0.01L;
+    }
+    long double loss_multiplier = loss / loss_denominator;
+    if (loss_multiplier > VOLPAROSSA_EDT_LOSS_MULTIPLIER_LIMIT) {
+        loss_multiplier = VOLPAROSSA_EDT_LOSS_MULTIPLIER_LIMIT;
+    }
+    uint64_t loss_cost = volparossa_edt_bounded_us(
+        (long double)srtt_us * loss_multiplier,
+        VOLPAROSSA_EDT_QUEUE_LIMIT_US);
+
+    uint64_t cost = srtt_us / 2;
+    cost = volparossa_edt_saturating_add(cost, queue_cost);
+    cost = volparossa_edt_saturating_add(cost, congestion_cost);
+    return volparossa_edt_saturating_add(cost, loss_cost);
+}
+
+static size_t
+volparossa_edt_scheduler_size(void)
+{
+    return 0;
+}
+
+static void
+volparossa_edt_scheduler_init(void *scheduler, xqc_log_t *log,
+                              xqc_scheduler_params_t *params)
+{
+    (void)scheduler;
+    (void)log;
+    (void)params;
+}
+
+static xqc_path_ctx_t *
+volparossa_edt_scheduler_get_path(void *scheduler, xqc_connection_t *conn,
+                                 xqc_packet_out_t *packet_out, int check_cwnd,
+                                 int reinject, xqc_bool_t *cc_blocked)
+{
+    (void)scheduler;
+    if (cc_blocked != NULL) {
+        *cc_blocked = XQC_FALSE;
+    }
+    if (conn == NULL || packet_out == NULL || reinject) {
+        return NULL;
+    }
+
+    xqc_path_ctx_t *best = NULL;
+    xqc_path_ctx_t *sendable_fallback = NULL;
+    uint64_t best_cost = UINT64_MAX;
+    xqc_bool_t reached_congestion_check = XQC_FALSE;
+    size_t visited = 0;
+    xqc_list_head_t *position;
+    xqc_list_head_t *next;
+    xqc_path_ctx_t *path;
+
+    xqc_list_for_each_safe(position, next, &conn->conn_paths_list) {
+        if (visited++ >= XQC_PATH_HARD_CAP) {
+            break;
+        }
+        path = xqc_list_entry(position, xqc_path_ctx_t, path_list);
+        if (path->path_state != XQC_PATH_STATE_ACTIVE
+            || path->app_path_status != XQC_APP_PATH_STATUS_AVAILABLE
+            || (path->path_flag & XQC_PATH_FLAG_SOCKET_ERROR)
+            || path->path_send_ctl == NULL)
+        {
+            continue;
+        }
+
+        reached_congestion_check = XQC_TRUE;
+        if (!xqc_scheduler_check_path_can_send(path, packet_out, check_cwnd)) {
+            continue;
+        }
+        if (sendable_fallback == NULL
+            || path->path_id < sendable_fallback->path_id)
+        {
+            sendable_fallback = path;
+        }
+
+        uint64_t cost = volparossa_edt_cost_us(path, packet_out->po_used_size);
+        if (cost == UINT64_MAX) {
+            continue;
+        }
+        if (best == NULL || cost < best_cost
+            || (cost == best_cost && path->path_id < best->path_id))
+        {
+            best = path;
+            best_cost = cost;
+        }
+    }
+
+    if (best == NULL) {
+        best = sendable_fallback;
+    }
+    if (cc_blocked != NULL && reached_congestion_check && best == NULL) {
+        *cc_blocked = XQC_TRUE;
+    }
+    if (best != NULL) {
+        xqc_log(conn->log, XQC_LOG_DEBUG,
+                "|volparossa_edt|select|path:%ui|cost_us:%ui|packet:%uz|",
+                best->path_id, best_cost, packet_out->po_used_size);
+    }
+    return best;
+}
+
+const xqc_scheduler_callback_t xqc_volparossa_edt_scheduler_cb = {
+    .xqc_scheduler_size = volparossa_edt_scheduler_size,
+    .xqc_scheduler_init = volparossa_edt_scheduler_init,
+    .xqc_scheduler_get_path = volparossa_edt_scheduler_get_path,
+};
